<%# The armour class of a fighter in a box that stands out, its initiative beside it (simulated: shown only with
    GameRoom.preview_features?), then, in the panel « Ma fiche », the values a player looks at in a fight
    (stats: CombatStripHelper#own_quick_stats, speed, proficiency), in boxes of the same size (game_rooms/
    _stat_box) that go to the line. In the quick sheet of the strip of the fighters and in the panel « Ma fiche » %>
<% stats = local_assigns.fetch(:stats, []) %>
<dl class="flex flex-wrap gap-2 text-center">
  <% if fighter.armor_class %>
    <div class="flex min-w-14 flex-col items-center justify-center rounded-lg border border-brass/60 bg-primary-soft px-2.5 py-1">
      <dt class="text-[10px] font-semibold tracking-wider text-primary-soft-ink uppercase"><%= t("game_rooms.combat_strip.armor_class_label") %></dt>
      <dd class="text-xl leading-tight font-bold text-ink tabular-nums"><%= fighter.armor_class %></dd>
    </div>
  <% end %>
  <% if GameRoom.preview_features? %>
    <div class="flex min-w-14 flex-col items-center justify-center rounded-lg bg-field px-2.5 py-1">
      <dt class="text-[10px] font-semibold tracking-wider text-muted uppercase"><%= t("game_rooms.combat_strip.initiative_label") %></dt>
      <dd class="text-xl leading-tight font-bold text-ink tabular-nums"><%= group.initiative %></dd>
    </div>
  <% end %>
  <% stats.each do |stat| %>
    <%= render "game_rooms/stat_box", stat: stat %>
  <% end %>
</dl>
