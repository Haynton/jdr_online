<%# The saving throws of a player's character in the quick sheet of the game master (decision of 26 November: asked
    for all the time): six small boxes, the abbreviation of the ability and the bonus, gold when proficient. The
    section of the template with one bonus per ability (PlayerSheetPanelsHelper#own_tile_bonus_section) %>
<% ability_fields = character.sheet_fields.select { |field| field["type"] == "ability" } %>
<% section, saves = own_tile_bonus_section(own_bonus_sections(character), ability_fields) %>
<% if section %>
  <section class="mt-4 border-t border-line pt-4" aria-label="<%= section %>">
    <h3 class="text-xs font-semibold tracking-wider text-muted uppercase"><%= section %></h3>
    <ul class="mt-2 grid grid-cols-6 gap-1.5">
      <% ability_fields.each do |ability| %>
        <% save = saves[ability["key"]] %>
        <% proficient = own_ticked?(character, save) %>
        <li class="flex flex-col items-center rounded-md border py-1 <%= proficient ? "border-brass/60 bg-primary-soft" : "border-line" %>"
            title="<%= save["label"] %>">
          <span class="text-[10px] font-semibold tracking-wider uppercase <%= proficient ? "text-primary-soft-ink" : "text-muted" %>"><%= ability["abbreviation"] || ability["label"] %></span>
          <span class="text-sm font-bold text-ink tabular-nums"><%= format_bonus(computed[:values][save["key"]]) %></span>
          <span class="sr-only"><%= save["label"] %><%= ", #{t("game_tables.characters.new.proficient")}" if proficient %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
