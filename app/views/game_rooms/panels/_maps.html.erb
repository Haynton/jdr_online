<%# The maps of the table, for the game master: each with its preview (its tokens and blocked zones drawn on it, like
    the step « Cartes ») or its image, its name and grid. « Placer » shows a drawn map on the board
    (room_board_controller.js, first version, nothing saved), then « Retirer » takes it off; the pencil opens it in the
    map editor, a map sent as an image in the step « Cartes » %>
<% game_maps = game_room.game_maps.to_a %>
<% if game_maps.empty? %>
  <p class="text-sm text-muted"><%= t(".empty") %></p>
<% end %>
<ul class="flex flex-col gap-3">
  <% game_maps.each do |game_map| %>
    <li class="overflow-hidden rounded-xl border border-line">
      <% if game_map.drawn? && map_preview?(game_map) %>
        <svg viewBox="<%= game_map_view_box(game_map) %>" class="block aspect-video w-full bg-well" aria-hidden="true"
             <%= tag.attributes(data: game_map_preview_data(game_map)) %>></svg>
      <% elsif game_map.drawn? %>
        <span class="flex aspect-video w-full items-center justify-center bg-primary-soft text-primary-soft-ink" aria-hidden="true">
          <%= render "shared/icons/map", css_class: "size-8" %>
        </span>
      <% else %>
        <%= image_tag game_map.image, alt: "", loading: "lazy", class: "aspect-video w-full bg-field object-cover" %>
      <% end %>
      <div class="flex items-center justify-between gap-3 px-3 py-2.5">
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-ink"><%= game_map.name %></p>
          <p class="text-xs text-muted"><%= game_map_grid_text(game_map) %></p>
        </div>
        <% if game_map.drawn? && GameRoom.preview_features? %>
          <button type="button" hidden aria-pressed="false"
                  class="<%= button_classes(:secondary, size: :compact) %> h-7 shrink-0 px-2.5 text-xs select-none aria-pressed:border-brass aria-pressed:bg-primary-soft aria-pressed:text-primary-soft-ink"
                  aria-label="<%= t("game_rooms.board.place_map", name: game_map.name) %>"
                  data-place-label="<%= t("game_rooms.board.place_map", name: game_map.name) %>"
                  data-remove-label="<%= t("game_rooms.board.remove_map", name: game_map.name) %>"
                  data-room-board-target="mapPlacer" data-action="room-board#placeMap"
                  data-room-board-id-param="<%= game_map.id %>">
            <span class="in-aria-pressed:hidden"><%= t("game_rooms.board.place") %></span>
            <span class="hidden in-aria-pressed:inline"><%= t("game_rooms.board.remove") %></span>
          </button>
        <% end %>
        <%= link_to edit_game_table_game_map_path(game_room.game_table, game_map),
                    class: button_classes(:secondary, size: :compact_icon), title: t(".open", name: game_map.name),
                    aria: { label: t(".open", name: game_map.name) } do %>
          <%= render "shared/icons/pencil" %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
<%# The maps of « Mes cartes » in the window of the step « Cartes » (game_tables/game_maps/_dialog, rendered by
    layouts/game_room), without leaving the room (Anthony's request): one chosen is copied into the table, the room is
    refreshed and the panel comes back open %>
<%= link_to new_game_table_game_map_path(game_room.game_table), data: map_dialog_link_data,
            class: "#{button_classes(:secondary, full_width: true)} mt-4 gap-2" do %>
  <%= render "shared/icons/plus" %>
  <%= t(".manage") %>
<% end %>
