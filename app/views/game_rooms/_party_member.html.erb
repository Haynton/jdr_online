<%# A player in the bar of the room (game_rooms/_toolbar): their avatar, round, in the ring of the gauge the template
    shows to others (the hit points, GameRoom#party_gauge_field), its length what is left of it; once the bar unfolds,
    their name and the same gauge as a bar, the numbers beside it. A character still being made has no ring. The game
    master opens the sheet of any of them in the window of the room, a player only their own (checked again by the
    server): a link then, else the same line, read only. Named for screen readers by party_member_name %>
<% name = party_member_name(game_room, character, gauge) %>
<% content = capture do %>
  <span class="relative flex size-8 shrink-0 items-center justify-center md:-mx-1.5">
    <%= render "characters/avatar", character: character, css_class: "size-6 rounded-full!", icon_class: "size-3.5" %>
    <% if gauge %>
      <svg viewBox="0 0 32 32" class="absolute inset-0 size-8 -rotate-90" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" fill="none" stroke-width="2.5" class="stroke-field"></circle>
        <circle cx="16" cy="16" r="14.5" fill="none" stroke-width="2.5" stroke-linecap="round" pathLength="100"
                class="stroke-success-ink" style="stroke-dasharray: <%= party_gauge_percent(gauge) %> 100"></circle>
      </svg>
    <% end %>
  </span>
  <span class="<%= GameRoomToolbarHelper::TOOLBAR_LABEL_CLASSES %>" aria-hidden="true">
    <span class="block truncate text-ink"><%= character_display_name(character) %></span>
    <% if gauge %>
      <span class="mt-1 flex items-center gap-2">
        <span class="h-1 w-24 overflow-hidden rounded-full bg-field">
          <span class="block h-full rounded-full bg-success-ink" style="width: <%= party_gauge_percent(gauge) %>%"></span>
        </span>
        <span class="text-xs text-muted tabular-nums"><%= gauge[:current] %>/<%= gauge[:max] %></span>
      </span>
    <% elsif character.draft? %>
      <span class="block text-xs text-muted"><%= t("game_rooms.party.draft") %></span>
    <% end %>
  </span>
<% end %>
<% if game_room.may_read_sheet?(character) %>
  <%= link_to content, game_table_character_sheet_path(game_room.game_table, character),
              class: "#{GameRoomToolbarHelper::TOOLBAR_TOOL_CLASSES}", aria: { label: name },
              data: character_sheet_dialog_link_data.merge(action: "game-room-panels#retractToolbar") %>
<% else %>
  <span class="<%= GameRoomToolbarHelper::TOOLBAR_TOOL_CLASSES %>" role="img" aria-label="<%= name %>"><%= content %></span>
<% end %>
