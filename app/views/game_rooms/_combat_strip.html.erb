<%# The strip of the fighters (first version, tried on the local branch style/testing-combat-strip: nothing saved
    or shared yet), an island at the bottom, left of the chat (decision:
    it holds the players, no more in the bar of tools), from 768 px (on the right edge until the chat shows, from
    1024 px), always there; its quick sheets open above it. Out of a fight (the start), the players alone (decision: the creatures join at the preparation),
    without an order of initiative (CombatStrip#resting_groups) and,
    for the game master, « Lancer un combat », which opens the preparation (decision: the game master sets the map, places
    the enemies and the blocked zones while the table rolls its initiative; the players see none of the creatures on
    the board until « Prêt », each marked with a crossed eye meanwhile). The rolls are simulated for now: the NPCs
    and the enemies at once, the players one after the other, each portrait faded until it has rolled, the count of
    those awaited in the strip. « Prêt » begins the fight (a player who has not rolled yet is rolled for, by the
    server in the real version), « Annuler » goes back out of a fight. In a fight, the order of initiative (CombatStrip#groups, each goblin its
    own), the round, the place whose turn it is ringed in gold, « Tour suivant » that moves it and « Fin du combat »
    (asked first in the confirmation window) that brings the strip back out of a fight (decision: the strip stays, only the turns go). 60 px high like the islands at
    the top, it keeps to the room between the bar of tools (88 px with its margins) and the chat (352 px): its
    portraits (40 px, their gold ring 4 px around, inside the 6 px margin of the list that scrolls: cut
    otherwise) scroll beyond. A portrait opens its quick sheet above the strip (game_rooms/_combat_sheet), for the
    game master any, for a player only their own. Nothing is saved: it all changes in this page only
    (combat_strip_controller.js) %>
<% groups = room_combat_strip.groups %>
<% if groups.any? %>
  <% initiative_ranks = groups.each_with_index.to_h { |group, index| [group.key, index] } %>
  <div class="absolute right-4 bottom-4 z-30 hidden max-w-[calc(100%-6.5rem)] flex-col-reverse items-end md:flex lg:right-88 lg:max-w-[calc(100%-29rem)]"
       data-controller="combat-strip" data-combat-strip-round-text-value="<%= t(".round", count: "__ROUND__") %>"
       data-combat-strip-conditions-title-value="<%= t(".conditions_title", name: "__NAME__") %>"
       data-combat-strip-waiting-one-value="<%= t(".preparing_waiting", count: 1) %>"
       data-combat-strip-waiting-other-value="<%= t(".preparing_waiting", count: "__COUNT__") %>"
       data-combat-strip-rolled-value="<%= t(".preparing_rolled") %>"
       data-action="keydown.esc->combat-strip#closeSheets click@window->combat-strip#closeOnOutsideClick">
    <div class="<%= GameRoomHelper::ISLAND_CLASSES %> flex h-15 max-w-full items-center gap-5 px-2" role="group"
         aria-label="<%= t(".label") %>">
      <span hidden class="shrink-0 pl-2 text-xs font-semibold whitespace-nowrap text-ink" data-combat-strip-target="round"><%= t(".round", count: 1) %></span>
      <ol class="flex min-w-0 items-center gap-3 overflow-x-auto p-1.5 no-scrollbar" data-combat-strip-target="order">
        <% room_combat_strip.resting_groups.each_with_index do |group, index| %>
          <li data-initiative-rank="<%= initiative_ranks.fetch(group.key) %>" data-rest-rank="<%= index %>"
              data-side="<%= group.side %>" <%= "hidden" unless group.side == :player %>>
            <%= render "game_rooms/combat_portrait", game_room: @game_room, group: group, current: false %>
          </li>
        <% end %>
      </ol>
      <% if @game_room.game_master? %>
        <button type="button" class="<%= button_classes(:secondary, size: :compact) %> shrink-0 gap-1.5 whitespace-nowrap"
                data-combat-strip-target="startButton" data-action="combat-strip#startFight">
          <%= render "shared/icons/swords", css_class: "size-4" %>
          <%= t(".start_fight") %>
        </button>
        <span hidden class="flex shrink-0 items-center gap-2" data-combat-strip-target="preparationButtons">
          <button type="button" class="<%= button_classes(:attention, size: :compact) %> gap-1.5 whitespace-nowrap"
                  data-action="combat-strip#ready">
            <%= render "shared/icons/check", css_class: "size-4" %>
            <%= t(".ready") %>
          </button>
          <button type="button" class="<%= button_classes(:secondary, size: :compact) %> whitespace-nowrap"
                  data-action="combat-strip#cancelPreparation">
            <%= t(".cancel_preparation") %>
          </button>
        </span>
        <span hidden class="flex shrink-0 items-center gap-2" data-combat-strip-target="fightButtons">
          <button type="button" class="<%= button_classes(:secondary, size: :compact) %> gap-1 whitespace-nowrap"
                  data-action="combat-strip#nextTurn">
            <%= t(".next_turn") %>
            <%= render "shared/icons/chevron_right", css_class: "size-4" %>
          </button>
          <button type="button" class="<%= button_classes(:secondary, size: :compact) %> whitespace-nowrap"
                  data-action="combat-strip#endFight" data-confirm-button="<%= t(".end_fight") %>"
                  data-confirm-question="<%= t(".end_fight_confirm") %>">
            <%= t(".end_fight") %>
          </button>
        </span>
      <% end %>
    </div>
    <% groups.each do |group| %>
      <% if combat_sheet_openable?(@game_room, group) %>
        <%= render "game_rooms/combat_sheet", game_room: @game_room, group: group %>
      <% end %>
    <% end %>
    <% if room_combat_strip.conditions.any? %>
      <%= render "game_rooms/conditions_dialog", conditions: room_combat_strip.conditions %>
    <% end %>
  </div>
<% end %>
