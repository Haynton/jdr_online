<%# The dice roll: "Roll the dice", the server rolls (ability_roll_controller.js, AbilityRollsController), the results
    as chips, placed from the list of each tile. An aid: the player may roll again or type their own scores %>
<div hidden class="mt-4" data-ability-roll-target="controls">
  <button type="button" class="<%= button_classes(:secondary) %>" data-ability-roll-target="button" data-action="ability-roll#roll">
    <%= render "shared/icons/dices" %>
    <span data-ability-roll-target="buttonLabel"><%= t("game_tables.characters.new.roll") %></span>
  </button>
</div>
<div hidden class="mt-4 flex flex-wrap gap-2" role="status" data-ability-roll-target="results"></div>
<%= render "character_sheets/ability_methods/result_chip_template" %>
