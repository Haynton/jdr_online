<%# A value to place, as a token of the tray (ability_roll_controller.js fills it: its total, its dice as a tooltip when
    it was rolled; ability_tokens_controller.js holds and places it) %>
<template data-ability-roll-target="chipTemplate">
  <button type="button" class="<%= CharacterSheets::AbilityCardsHelper::TOKEN_CLASSES %>" aria-pressed="false"
          data-ability-tokens-target="valueToken" data-kind="value" data-action="ability-tokens#hold">
    <span class="relative" data-total></span>
  </button>
</template>
