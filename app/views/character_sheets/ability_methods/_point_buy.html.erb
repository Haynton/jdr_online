<%# The point buy, in the tray: the points spent on the scores of the cards, counted again as they change
    (point_buy_controller.js, the bonus of the background shown in the scores left aside), in red past the points; then
    a "+" and a "−" (decision: tools like the tokens, instead of a "−" and a "+" on each card): the player holds one,
    then touches the cards to raise or lower their score by one, between the lowest and the highest cost, within the
    points (ability_tokens_controller.js). The server refuses more points than allowed (AbilityMethods::PointBuy), its
    message under the count %>
<% too_many_points = character.errors[:ability_scores].first %>
<div class="flex items-center gap-2">
  <%= tag.p point_buy_status(character, ability_method), role: "status",
            class: "text-sm font-semibold text-ink tabular-nums data-invalid:text-error-ink",
            data: { point_buy_target: "status",
                    invalid: ("" if points_spent(character, ability_method) > ability_method["points"]) } %>
  <span class="ml-1 flex items-center gap-1">
    <% { 1 => "+", -1 => "−" }.each do |step, sign| %>
      <button type="button" class="<%= CharacterSheets::AbilityCardsHelper::TOKEN_CLASSES %>" aria-pressed="false"
              aria-label="<%= t(step.positive? ? "character_sheets.ability_cards.raise" : "character_sheets.ability_cards.lower") %>"
              data-ability-tokens-target="stepToken" data-kind="step" data-step="<%= step %>"
              data-action="ability-tokens#hold">
        <span class="relative"><%= sign %></span>
      </button>
    <% end %>
  </span>
</div>
<% if too_many_points %>
  <p class="<%= SimpleFormFieldClasses::ERROR %>"><%= too_many_points %></p>
<% end %>
