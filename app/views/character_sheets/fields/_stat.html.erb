<%# The look of a number, a resource or a computed value, wherever it is on the sheet (decision: one look per type,
    the level as the hit points): a box as wide as an ability tile, its name at the top, on two lines at most (room
    kept for two lines, so that the values line up; the full name stays as a tooltip), then the number between "−"
    and "+", or the computed value large (initiative, proficiency, hit dice). Its help is a note under the row, opened
    by the button (i) at the top right of the box (info_notes_controller.js, rendered hidden and shown by it); the
    name keeps room on both sides (px-4) so that the button never covers it %>
<% error = sheet_field_error(character, field) %>
<% note_ids = sheet_field_note_ids(field) %>
<div class="relative flex w-[9.625rem] flex-col items-center gap-2 rounded-xl border border-line bg-surface px-2 pt-3 pb-2.5">
  <% if note_ids.any? %>
    <button type="button" hidden class="absolute top-1.5 right-1.5 flex size-6 cursor-pointer items-center justify-center rounded-full text-muted hover:bg-surface-raised hover:text-ink"
            aria-expanded="false" aria-controls="<%= note_ids.first %>"
            aria-label="<%= t("game_tables.characters.new.about", label: field["label"]) %>"
            data-info-notes-target="button" data-action="info-notes#toggle">
      <%= render "shared/icons/info" %>
    </button>
  <% end %>
  <div class="w-full px-4">
    <% if sheet_stat_computed?(field) %>
      <p id="<%= sheet_field_id(field) %>_label" class="<%= stat_label_classes %>" title="<%= field["label"] %>"><%= field["label"] %></p>
    <% else %>
      <%= label_tag sheet_field_id(field), field["label"], class: stat_label_classes, title: field["label"] %>
    <% end %>
  </div>
  <% if sheet_stat_computed?(field) %>
    <%= tag.output format_computed_value(computed[:values][field["key"]]),
                   class: "flex h-10 items-center text-xl font-bold text-ink tabular-nums",
                   aria: { labelledby: "#{sheet_field_id(field)}_label", describedby: note_ids.join(" ").presence },
                   data: computed_value_data(field) %>
  <% else %>
    <%= render "character_sheets/fields/stepper", field: field, input: sheet_stepper_input(character, field) %>
  <% end %>
  <% if error %>
    <p id="<%= sheet_field_id(field) %>_error" class="<%= SimpleFormFieldClasses::ERROR %> text-center"><%= error %></p>
  <% end %>
</div>
