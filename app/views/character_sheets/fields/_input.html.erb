<%# A choice or a text to fill in, at its own width: its label, its control, its help, its error. A number is not
    drawn here: it has its box (character_sheets/fields/_stat), wherever it is (decision: one look per type). A list the
    sheet does not ask yet (the subclass, before level 3) is hidden, and follows its level and its list on the page %>
<% error = sheet_field_error(character, field) %>
<% hint = sheet_field_hint(field) %>
<%= tag.div class: "#{SimpleFormFieldClasses::FIELD_BLOCK} #{sheet_field_width_classes(field)}",
            hidden: !sheet_field_asked?(character, field), data: sheet_dependent_choice_data(character, field) do %>
  <%= label_tag sheet_field_id(field), field["label"], class: SimpleFormFieldClasses::LABEL %>
  <%= sheet_field_control(character, field) %>
  <% if hint %>
    <p class="<%= SimpleFormFieldClasses::HINT %>"><%= hint %></p>
  <% end %>
  <% if error %>
    <p id="<%= sheet_field_id(field) %>_error" class="<%= SimpleFormFieldClasses::ERROR %>"><%= error %></p>
  <% end %>
<% end %>
