<%# A saving throw or a skill, as a line of the sheet (CharacterSheets::SkillRowsHelper): a small diamond, its bonus, its
    name (and what gives it: « Paladin »), the abbreviation of its ability. The player only ticks its proficiency, by
    touching the whole line: the box, the field sent, is hidden in it (sr-only). The bonus is the modifier of the ability,
    plus the proficiency bonus when ticked (CharacterSheets::Calculator, and character_sheet_controller.js while the
    player types). A skill the character may give expertise to has a box « Expertise » too, once ticked
    (sheet_expertise_check_box): its proficiency counts twice %>
<% state = skill_row_state(character, field) %>
<% given_by = sheet_given_by(character, field) %>
<% availability = skill_row_availability(character, field, state) %>
<%= tag.div class: "group/skill relative",
            data: { state: state, character_sheet_target: "bonusRow", skill_rows_target: "row", key: field["key"],
                    offered: ("" if skill_row_offered?(character, field)),
                    off: ("" if skill_row_off?(character, field, state)) } do %>
  <%= sheet_check_box(character, field, availability: availability, css_class: "peer sr-only") %>
  <%= label_tag sheet_field_id(field), class: skill_row_classes(state) do %>
    <span class="<%= skill_marker_classes(state) %>" aria-hidden="true"></span>
    <output class="text-right font-bold tabular-nums"
            data-character-sheet-target="bonus" data-based-on="<%= field["based_on"] %>"
            data-proficiency="<%= field["proficiency"] %>" data-proficient-box="<%= sheet_field_id(field) %>"
            data-expertise-box="<%= sheet_field_id(field) %>-expertise"><%= format_bonus(value) %></output>
    <span class="truncate">
      <%= field["label"] %>
      <% if given_by %>
        <span class="ml-1.5 text-xs font-normal text-muted"><%= given_by %></span>
      <% end %>
    </span>
    <%# Hidden on a narrow line (the column of the saving throws): their name says the ability already %>
    <span class="hidden text-xs font-normal text-muted group-has-[input[value='1']:checked]/skill:text-current @sm:block"><%= sheet_ability_abbreviation(all_fields, field["based_on"]) %></span>
  <% end %>
  <% if (expertise_box = sheet_expertise_check_box(character, field)) %>
    <%# Shown only once the skill is ticked (or already in expertise), on the line, left of the ability %>
    <label class="absolute top-1/2 right-14 hidden -translate-y-1/2 cursor-pointer items-center gap-1.5 text-xs text-primary-soft-ink group-has-[input[value='1']:checked]/skill:flex group-has-[input[value='2']:checked]/skill:flex"
           title="<%= t("game_tables.characters.new.expertise_hint") %>">
      <%= expertise_box %>
      <span aria-hidden="true"><%= t("game_tables.characters.new.expertise") %></span>
    </label>
  <% end %>
<% end %>
