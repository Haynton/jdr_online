<%# A saving throw or a skill: the player only ticks its proficiency. Its bonus, on the right, is the modifier of its
    ability (abbreviation beside the name), plus the proficiency bonus when ticked (CharacterSheets::Calculator,
    and character_sheet_controller.js while the player types). Marked "Proposée" when the option picked in a list
    offers it (skill_choices: the class of the character), by data-offered, set by the controller %>
<div class="group flex items-center gap-3 border-b border-line py-2"
     data-character-sheet-target="bonusRow" data-key="<%= field["key"] %>">
  <%= sheet_check_box(character, field) %>
  <%= label_tag sheet_field_id(field), class: "min-w-0 flex-1 cursor-pointer text-sm text-ink" do %>
    <%= field["label"] %>
    <span class="text-xs text-muted"><%= sheet_ability_abbreviation(all_fields, field["based_on"]) %></span>
    <span class="hidden text-xs font-medium text-brass group-data-offered:inline">
      · <%= t("game_tables.characters.new.offered") %>
    </span>
    <span class="sr-only"><%= t("game_tables.characters.new.proficient") %></span>
  <% end %>
  <output class="w-8 shrink-0 text-right text-sm font-semibold text-ink tabular-nums"
          data-character-sheet-target="bonus" data-based-on="<%= field["based_on"] %>"
          data-proficiency="<%= field["proficiency"] %>" data-proficient-box="<%= sheet_field_id(field) %>"><%= format_bonus(value) %></output>
</div>
