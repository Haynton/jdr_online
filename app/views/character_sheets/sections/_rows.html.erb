<%# Saving throws and skills: one tight row each, in two then three columns. Their help is said once, under the
    title of the section, rather than under one of the rows. When an option of a list can offer some of them (the
    skills of a class), how many to pick and how many are ticked, written by character_sheet_controller.js, in the
    colour of an error past the limit when the table limits the skills (data-limited); then what the server refused %>
<% sheet_section_helps(fields).each do |help| %>
  <p class="clear-left mb-3 text-sm text-muted"><%= help %></p>
<% end %>
<% if sheet_offered_by_a_choice?(fields, all_fields) %>
  <p hidden role="status" class="clear-left mb-3 text-sm font-medium text-ink data-invalid:text-error-ink"
     data-character-sheet-target="skillChoices" <%= "data-limited" if skill_choices_limited?(character) %>
     data-template="<%= t("game_tables.characters.new.skill_choices", option: "%{option}", count: "%{count}",
                                                                     chosen: "%{chosen}") %>"></p>
<% end %>
<% sheet_rows_errors(character, fields).each do |message| %>
  <p class="clear-left mb-3 text-sm text-error-ink first-letter:uppercase"><%= message %></p>
<% end %>
<div class="clear-left grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
  <% fields.each do |field| %>
    <%= render "character_sheets/fields/bonus", character: character, field: field, all_fields: all_fields,
                                                    value: computed[:values][field["key"]] %>
  <% end %>
</div>
