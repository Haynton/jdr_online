<%# The abilities step as a game screen (decision, prototype "Création façon jeu"), on one centered column: the way to get
    the scores (picked by the player when the table leaves it to them) and its help, then a tray of tokens: the values
    to place (the standard array, or "Roll the dice" and its results), the bonus of the background (+2 and +1, or +1 on
    three, as its rule allows) and "Start again"; a line that says what to do; then the six cards
    (character_sheets/fields/_ability_card). The player touches a token, then the card where it goes
    (ability_tokens_controller.js). A point buy has no values to place: its scores are typed in the cards, the points
    spent in the tray. The tokens fill the fields the step always sent: the server checks them as before %>
<% game_table = character.game_table %>
<% ability_fields = fields.select { |field| field["type"] == "ability" } %>
<% bonus_field = ability_bonus_field(fields) %>
<% raised_keys = raised_ability_keys(character, bonus_field) %>
<% ability_method = character.ability_method_in_use %>
<%= tag.div class: "clear-left flex flex-col items-center", data: ability_cards_section_data(character, bonus_field) do %>
  <% if game_table.players_choose_ability_method? %>
    <div class="mb-4 w-full max-w-md"><%= render "character_sheets/ability_methods/picker", character: character %></div>
  <% end %>
  <% if ability_method %>
    <p class="mb-4 max-w-2xl text-center text-sm text-muted"><%= ability_method["help"] %></p>
  <% else %>
    <p class="mb-4 max-w-2xl text-center text-sm text-muted"><%= t("game_tables.characters.new.type_scores") %></p>
  <% end %>

  <%# The tray: what the way needs (its partial, said by its class in AbilityMethods), the bonus, then its button (Start
      again, or Roll the dice) %>
  <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-3">
    <% if ability_method %>
      <%= render AbilityMethods.find(ability_method["type"]).guide_partial, character: character, ability_method: ability_method %>
    <% end %>
    <% if bonus_field && raised_keys.any? %>
      <span class="mx-2 h-8 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
      <%= render "character_sheets/sections/ability_bonus_tokens", character: character, bonus_field: bonus_field %>
    <% end %>
    <%# On a phone, the button goes to its own line: a little more room above it %>
    <div class="ml-2 max-sm:mt-3">
      <%= render(ability_method ? AbilityMethods.find(ability_method["type"]).tray_action_partial : "character_sheets/ability_methods/start_again") %>
    </div>
  </div>
  <p class="mt-4 min-h-5 text-center text-sm text-muted" aria-live="polite" data-ability-tokens-target="hint"></p>
  <% if bonus_field && raised_keys.none? %>
    <p class="mt-1 text-center text-sm text-muted"><%= t("game_tables.characters.new.bonus_pick_background") %></p>
  <% end %>
  <% if bonus_field && (bonus_error = sheet_field_error(character, bonus_field)) %>
    <p class="<%= SimpleFormFieldClasses::ERROR %> text-center"><%= bonus_error %></p>
  <% end %>

  <div class="mt-10 grid w-full max-w-5xl grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 @4xl:grid-cols-6 [@media(max-height:820px)]:mt-8">
    <% ability_fields.each do |field| %>
      <%= render "character_sheets/fields/ability_card", character: character, field: field,
                                                             modifier: computed[:modifiers][field["key"]],
                                                             bonus_field: (bonus_field if raised_keys.include?(field["key"])) %>
    <% end %>
  </div>
<% end %>
