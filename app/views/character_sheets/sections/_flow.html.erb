<%# Any other section: each field drawn by its type, with the same look wherever it is (sheet_field_partial), and
    arranged by group (sheet_flow_groups, decision): the lists and short texts in a grid of equal widths (one, two,
    then three per line, by the width of the section), then the boxes and tiles side by side, then the picks, then the
    long texts, then the switches. Mixed on one line, the lists (label above) and the boxes (label inside) did not line
    up. The lists and the picks share a line (sheet_flow_rows). A section of short choices and long texts has
    its own layout in two columns (character_sheets/sections/_split: the Details step).
    paired: the lists two by two, narrow, one under the other on a phone (the first step, decision).
    The help of a boxed field is a note under the row, hidden until its button (i) in the box opens it (decision: the
    notes all shown made a wall of text; info_notes_controller.js). Without JavaScript, the notes stay shown %>
<div class="@container clear-left flex flex-col gap-4" data-controller="info-notes">
  <%# paired: each group on its own line (the lists two by two, then the languages under them): beside the lists, the
      languages squeezed them onto one column and ran past their column %>
  <% rows = local_assigns[:paired] ? sheet_flow_groups(fields).map { |group| [group] } : sheet_flow_rows(fields) %>
  <% rows.each do |row| %>
    <div class="<%= row.size > 1 ? "flex flex-wrap items-start gap-x-12 gap-y-4" : "contents" %>">
      <% row.each do |group, group_fields| %>
        <%# basis-64: with less room beside the lists, the picks go under them (min-w-0 alone let them shrink to
            55 px on a phone, their labels past the page) %>
        <% group_classes = if row.size > 1
                             group == :lists ? "flex w-60 flex-col" : "min-w-0 flex-1 basis-64"
                           elsif local_assigns[:paired] && group == :lists
                             "grid gap-x-4 sm:grid-cols-2"
                           else
                             sheet_flow_group_classes(group)
                           end %>
        <%= tag.div class: group_classes do %>
          <% group_fields.each do |field| %>
            <%= render sheet_field_partial(field),
                       character: character, field: field, computed: computed, all_fields: all_fields,
                       modifier: computed[:modifiers][field["key"]], value: computed[:values][field["key"]] %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% sheet_section_notes(fields).each do |note| %>
    <p id="<%= note[:id] %>" class="max-w-3xl rounded-lg bg-surface px-4 py-3 text-sm text-ink"
       data-info-notes-target="note">
      <%= t("game_tables.characters.new.note_html", labels: tag.span(note[:labels], class: "font-semibold"),
                                                    text: note[:text]) %>
    </p>
  <% end %>
</div>
