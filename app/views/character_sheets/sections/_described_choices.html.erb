<%# The first step, in three columns from 1024 px (decision): the avatar, the fields (the name first, lead, then the
    lists two by two: class, background, species, size), then a summary of each option picked: its description,
    then what it brings (CharacterSheets::ChoiceSummariesHelper), plain text on the page, not in a card (decision). From 768 px, the
    avatar and the fields side by side, the summary under them; on a phone, one under the other.
    The avatar is the picker of its picture (shared/_avatar_picker), its forms written outside the form of the step.
    Every option is rendered, the one picked shown; described_choices_controller.js shows the one picked while the
    player changes the list, and the summary is read again by screen readers (polite). A list the sheet does not ask
    yet (the subclass, before level 3) has its summary hidden with it (dependent_choice_controller.js), and the
    features of an option (CharacterSheets::FeaturesHelper) show from their level, each opening its summary in the
    window of the page (shared/_details_dialog) %>
<div class="clear-left grid gap-x-12 gap-y-8 md:grid-cols-[11rem_minmax(0,1fr)] lg:grid-cols-[12rem_minmax(0,1fr)_minmax(0,1fr)]"
     data-controller="described-choices details-dialog" data-action="change->described-choices#show input->described-choices#show">
  <%= render "shared/details_dialog" %>
  <%# 128 px on a phone, where it would push the fields down; its column from 768 px %>
  <div class="w-32 self-start md:w-full">
    <%= render "shared/avatar_picker", picker: character_avatar_picker(character), detached: true %>
  </div>
  <%# The fields stay narrow (448 px at most, two lists per line from 640 px, decision): their texts are short %>
  <div class="min-w-0 max-w-md">
    <% if lead %>
      <div><%= lead %></div>
    <% end %>
    <%= render "character_sheets/sections/flow", character: character, fields: fields,
                                                     all_fields: all_fields, computed: computed, paired: true %>
  </div>
  <aside class="flex flex-col gap-6 self-start md:col-span-2 lg:sticky lg:top-6 lg:col-span-1"
         aria-label="<%= t("game_tables.choice_summaries.label") %>" aria-live="polite">
    <% described_choice_fields(fields).each do |field| %>
      <%= tag.section hidden: !sheet_field_asked?(character, field), data: { shown_with: field["key"] } do %>
        <h3 class="text-xs font-semibold tracking-wider text-brass uppercase"><%= field["label"] %></h3>
        <p class="mt-2 text-sm text-muted" data-described-choices-target="empty" data-field="<%= field["key"] %>"
           <%= "hidden" if choice_picked?(character, field) %>><%= t("game_tables.choice_summaries.nothing_picked") %></p>
        <% field["options"].each do |option| %>
          <%= tag.div hidden: choice_option_hidden?(character, field, option), class: "mt-1",
                      data: { described_choices_target: "option", field: field["key"], option: option } do %>
            <p class="text-lg font-semibold tracking-tight text-ink"><%= option %></p>
            <p class="mt-1 text-sm text-ink"><%= field.dig("descriptions", option) %></p>
            <dl class="mt-3 flex flex-col gap-1.5 text-sm">
              <% choice_option_facts(field, option, all_fields).each do |label, text, from_level| %>
                <%= tag.div class: "flex flex-wrap gap-x-2", hidden: choice_fact_hidden?(character, field, from_level),
                            data: choice_fact_data(character, field, from_level) do %>
                  <dt class="text-muted"><%= label %></dt>
                  <dd class="font-medium text-ink"><%= text %></dd>
                <% end %>
              <% end %>
            </dl>
            <% features = choice_option_features(character, field, option) %>
            <% if features.any? %>
              <h4 class="mt-4 text-sm text-muted"><%= t("game_tables.choice_summaries.features") %></h4>
              <ul class="mt-1.5 flex flex-col gap-1">
                <% features.each do |feature| %>
                  <%= tag.li hidden: feature_hidden?(character, field, feature),
                             data: feature_line_data(character, field, feature) do %>
                    <%= render "character_sheets/features/line", feature: feature %>
                  <% end %>
                <% end %>
              </ul>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </aside>
</div>
