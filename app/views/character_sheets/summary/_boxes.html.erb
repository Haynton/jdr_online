<%# Numbers, resources and worked out values on the summary sheet (armour class, hit points, initiative...), kept small
    (decision): a box each, the label at the top, the value under it. Room kept
    for two lines of label (min-h-[2lh]), so that the values of a line stay level (« Classe d'armure » on two lines
    pushed its value down) %>
<%# Three per line (decision: as many as fitted made 5 + 1 for the six values of the combat) %>
<div class="mt-3 grid grid-cols-3 gap-2">
  <% fields.each do |field| %>
    <div class="flex flex-col items-center gap-0.5 rounded-lg border border-line bg-surface px-1.5 py-2 text-center">
      <span class="flex min-h-[2lh] items-center text-[10px] leading-tight font-semibold tracking-wider text-muted uppercase">
        <span class="line-clamp-2"><%= field["label"] %></span>
      </span>
      <span class="text-base font-bold text-ink tabular-nums"><%= summary_value(character, field, computed) %></span>
    </div>
  <% end %>
</div>
