<%# The block « Dons » of the summary and of the sheet of « Mes personnages » (decision of 27 November): each origin
    feat of the creation (the background's, the one the human picked), its list for Magic Initiate, where it comes from,
    then the spells or the skills picked for it %>
<% labels = character.sheet_fields.to_h { |field| [field["key"], field["label"]] } %>
<% spell_names = character.spells.to_a.to_h { |spell| [spell["key"], spell["name"]] } %>
<ul class="mt-3 flex flex-col gap-4">
  <% character.origin_feats_taken.each do |feat, entry, source| %>
    <% list = entry["spell_list"] %>
    <% picked = Array(entry["cantrips"]) + Array(entry["spell"]) %>
    <li>
      <p class="text-sm font-semibold text-ink">
        <%= list ? t("game_tables.character_steps.feat_cards.with_list", feat: feat.name, list: list) : feat.name %>
        <span class="text-xs font-medium text-brass">· <%= character.feat_origin("source" => source) %></span>
      </p>
      <% if picked.any? %>
        <p class="mt-0.5 text-sm text-muted"><%= picked.map { |key| spell_names[key] || key }.to_sentence %></p>
      <% end %>
      <% if Array(entry["skills"]).any? %>
        <p class="mt-0.5 text-sm text-muted"><%= Array(entry["skills"]).map { |key| labels[key] || key }.to_sentence %></p>
      <% end %>
    </li>
  <% end %>
</ul>
