<%# The spells chosen on the summary sheet, under the save DC and the attack bonus of the Spells block: the cantrips,
    then the prepared spells by level, each with its school, as on a sheet of a game. First the spell slots of the
    character, when its class has some at its level %>
<% if (slots = character_spell_slots(character)) %>
  <%= render "character_sheets/summary/spell_slots", slots: slots %>
<% end %>
<% summary_spell_groups(character).each do |title, spells| %>
  <h3 class="mt-5 text-sm font-semibold text-ink"><%= title %></h3>
  <ul class="mt-2 grid gap-x-6 gap-y-1 sm:grid-cols-2">
    <% spells.each do |spell| %>
      <li class="flex items-baseline gap-2 text-sm">
        <span class="text-ink"><%= spell["name"] %></span>
        <span class="text-xs text-muted"><%= spell.dig("properties", "school") %></span>
      </li>
    <% end %>
  </ul>
<% end %>
