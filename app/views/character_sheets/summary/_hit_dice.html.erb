<%# Under the hit points on the summary (the block of the step that holds them), when the levels after the first get
    hit dice to roll (Character#hit_dice_to_roll, CharacterHitPoints): rolled, the dice kept; not yet, "Roll the hit
    dice" (the server rolls once). Imposed by the table, the button stands out (attention: the character cannot be
    finished without it); left to the player, the average counts until they roll %>
<% dice = character.hit_dice_to_roll %>
<% rolls = character.kept_hit_point_rolls %>
<% scope = "game_tables.character_steps.summary.hit_dice" %>
<% if dice && (rolls || character.may_roll_hit_dice?) %>
  <div class="mt-4 text-sm">
    <% if rolls %>
      <p class="text-muted"><%= t("#{scope}.rolled", dice: "d#{dice[:sides]}", results: rolls.join(", ")) %></p>
    <% else %>
      <% imposed = !character.game_table.players_choose?(CharacterHitPoints::RULE) %>
      <p class="text-muted">
        <%= t(imposed ? "#{scope}.to_roll" : "#{scope}.may_roll", dice: "#{dice[:count]}d#{dice[:sides]}") %>
      </p>
      <%= button_to game_table_hit_dice_roll_path(character.game_table), form_class: "mt-3",
                    class: button_classes(imposed ? :attention : :secondary) do %>
        <%= render "shared/icons/dices" %>
        <%= t("#{scope}.roll") %>
      <% end %>
    <% end %>
    <% if (error = character.errors[:hit_point_rolls].first) %>
      <p class="<%= SimpleFormFieldClasses::ERROR %>"><%= error %></p>
    <% end %>
  </div>
<% end %>
