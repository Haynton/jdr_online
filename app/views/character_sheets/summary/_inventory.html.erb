<%# What a complete character carries (« Mes personnages »): the lines of its inventory (copies of the catalog made at
    the end of its creation, InventoryItem), each with how many and its damage or armour class, its description at
    hand (in a window, summary/_entry_details), then the values of the game kept in the same sections (the gold).
    A character made before the inventory existed has none: the block says so %>
<% items = character.inventory_items.sort_by(&:name) %>
<% play_fields = summary_play_fields(character, step) %>
<h3 class="mt-5 text-sm font-semibold text-ink"><%= t("character_sheets.summary.inventory.title") %></h3>
<% if items.empty? && play_fields.empty? %>
  <p class="mt-2 text-sm text-muted"><%= t("character_sheets.summary.inventory.empty") %></p>
<% else %>
  <ul class="mt-2 grid items-start gap-x-6 gap-y-1 sm:grid-cols-2">
    <% items.each do |item| %>
      <li>
        <%= render layout: "character_sheets/summary/entry_details",
                   locals: { title: item.name, subtitle: inventory_item_detail(item), description: item.description } do %>
          <span class="text-ink"><%= inventory_item_text(item) %></span>
          <% if (detail = inventory_item_detail(item)) %>
            <span class="text-xs text-muted"><%= detail %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
    <% play_fields.each do |field| %>
      <li class="text-sm font-medium text-brass">
        <%= t("character_sheets.summary.inventory.play_value", label: field["label"],
                                                               value: FieldTypes.of(field).summary_text(character.sheet[field["key"]], field)) %>
      </li>
    <% end %>
  </ul>
<% end %>
