<%# The abilities on the summary sheet, like on a sheet of a game, kept small (decision): the abbreviation, the
    modifier, and the score in a round that overlaps the bottom edge of the tile (decision). Three per line, six from
    640 px, never wider than 672 px in all; room kept under each line for the rounds (gap-y-6, mb-3) %>
<div class="mt-3 mb-3 grid max-w-2xl grid-cols-3 gap-x-2 gap-y-6 sm:grid-cols-6">
  <% fields.each do |field| %>
    <div class="relative flex flex-col items-center rounded-lg border border-line bg-surface px-1.5 pt-2 pb-4">
      <span class="w-full truncate text-center text-[10px] font-semibold tracking-wider text-muted uppercase"
            title="<%= field["label"] %>"><%= field["abbreviation"] || field["label"] %></span>
      <span class="text-lg font-bold text-ink tabular-nums">
        <span class="sr-only"><%= field["label"] %>, <%= t("game_tables.characters.new.modifier") %></span>
        <%= format_bonus(computed[:modifiers][field["key"]]) %>
      </span>
      <%# The final score: the score typed plus the bonus of the background %>
      <span class="absolute -bottom-3 left-1/2 flex size-7 -translate-x-1/2 items-center justify-center rounded-full border border-line bg-surface text-xs font-semibold text-ink tabular-nums"><%= computed[:scores]&.dig(field["key"]) || summary_value(character, field, computed) %></span>
    </div>
  <% end %>
</div>
