<%# Development and test only (see config/routes.rb). The texts stay in English and written here
    on purpose: this page is a tool for the team, never shown to players nor served in production. %>
<h1 class="text-2xl font-bold text-ink">Component gallery</h1>
<p class="mt-1 text-sm text-muted">Use the theme buttons in the navbar to review every component in both themes.</p>

<section class="mt-8" aria-labelledby="logo-title">
  <h2 id="logo-title" class="text-lg font-semibold text-ink">Logo</h2>
  <div class="mt-4 inline-flex rounded-lg border border-line bg-surface p-4">
    <%= render "shared/logo" %>
  </div>
</section>

<section class="mt-8" aria-labelledby="buttons-title">
  <h2 id="buttons-title" class="text-lg font-semibold text-ink">Buttons</h2>
  <% @button_variants.each do |button_variant| %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="w-20 text-sm text-muted"><%= button_variant %></span>
      <button type="button" class="<%= button_classes(button_variant) %>">Normal</button>
      <button type="button" class="<%= button_classes(button_variant, size: :compact) %>">Compact</button>
      <button type="button" class="<%= button_classes(button_variant) %>">
        <%= render "shared/icons/plus" %>
        With icon
      </button>
      <button type="button" class="<%= button_classes(button_variant) %>" disabled>Disabled</button>
    </div>
  <% end %>
</section>

<section class="mt-8" aria-labelledby="badges-title">
  <h2 id="badges-title" class="text-lg font-semibold text-ink">Badges</h2>
  <div class="mt-4 flex items-center gap-3">
    <span class="<%= badge_classes(:game_master) %>">GM</span>
    <span class="<%= badge_classes(:player) %>">Player</span>
    <%# Next to a real button, to check that a badge never reads as one %>
    <button type="button" class="<%= button_classes(:secondary, size: :compact) %>">Open</button>
  </div>
</section>

<section class="mt-8" aria-labelledby="forms-title">
  <h2 id="forms-title" class="text-lg font-semibold text-ink">Forms</h2>
  <p class="mt-1 text-sm text-muted">Styled once in config/initializers/simple_form.rb. Hover a field, then use Tab to see the focus.</p>
  <div class="mt-4 max-w-md rounded-xl border border-line bg-surface p-6">
    <%= simple_form_for @demo_user, url: dev_components_path, method: :get do |form| %>
      <%= form.input :email, hint: "Error state: the address is invalid" %>
      <%= form.input :password, placeholder: "Placeholder text", hint: "A hint under the field" %>
      <%= form.input :password_confirmation, disabled: true, hint: "Disabled field" %>
      <%= form.input :locale, collection: locale_options, include_blank: "Browser language",
                              hint: "Native select: keyboard and mobile keep working" %>
      <%= form.input :remember_me, as: :boolean %>
    <% end %>
  </div>
</section>

<section class="mt-8" aria-labelledby="messages-title">
  <h2 id="messages-title" class="text-lg font-semibold text-ink">Messages</h2>
  <div class="mt-4 grid max-w-2xl gap-3">
    <%= render layout: "shared/message", locals: { variant: :success } do %>Your account has been updated.<% end %>
    <%= render layout: "shared/message", locals: { variant: :error } do %>Invalid email or password.<% end %>
    <div class="rounded-xl border border-line bg-surface p-6">
      <%= render layout: "shared/message", locals: { variant: :error } do %>
        <p class="font-semibold">2 errors prohibited this account from being saved:</p>
        <ul class="mt-1 list-disc pl-4">
          <li>Email is invalid</li>
          <li>Password can't be blank</li>
        </ul>
      <% end %>
    </div>
  </div>
</section>

<section class="mt-8" aria-labelledby="switches-title">
  <h2 id="switches-title" class="text-lg font-semibold text-ink">Switches</h2>
  <div class="mt-4 grid max-w-md gap-4 rounded-xl border border-line bg-surface p-6">
    <div class="flex items-center justify-between gap-4">
      <span id="switch-noise-label" class="text-sm text-ink">Noise reduction (off)</span>
      <%= render "shared/switch", id: "switch-noise", labelled_by: "switch-noise-label" %>
    </div>
    <div class="flex items-center justify-between gap-4">
      <span id="switch-push-label" class="text-sm text-ink">Push to talk (on)</span>
      <%= render "shared/switch", id: "switch-push", labelled_by: "switch-push-label", checked: true %>
    </div>
    <div class="flex items-center justify-between gap-4">
      <span id="switch-disabled-label" class="text-sm text-muted">Disabled</span>
      <%= render "shared/switch", id: "switch-disabled", labelled_by: "switch-disabled-label", disabled: true %>
    </div>
  </div>
</section>

<section class="mt-8" aria-labelledby="colors-title">
  <h2 id="colors-title" class="text-lg font-semibold text-ink">Colors</h2>
  <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <% @color_swatches.each do |color_swatch| %>
      <div class="rounded-lg border border-line bg-surface p-3">
        <div class="h-12 rounded-md border border-line <%= color_swatch[:css_class] %>"></div>
        <p class="mt-2 text-sm text-ink"><%= color_swatch[:name] %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="mt-8" aria-labelledby="icons-title">
  <h2 id="icons-title" class="text-lg font-semibold text-ink">Icons</h2>
  <div class="mt-4 grid grid-cols-3 gap-4 sm:grid-cols-5">
    <% @icon_names.each do |icon_name| %>
      <div class="flex flex-col items-center gap-2 rounded-lg border border-line bg-surface p-3 text-ink">
        <%= render "shared/icons/#{icon_name}", css_class: "size-5" %>
        <span class="text-xs text-muted"><%= icon_name %></span>
      </div>
    <% end %>
  </div>
</section>
