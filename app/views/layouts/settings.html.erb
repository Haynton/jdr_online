<%# Nested layout of the settings, centered in 1120 px like the other pages: the section menu on the page
    background on the left (240 px, from 768 px), the section in a card on the right.
    On a phone, /settings shows the list of sections, and a section page its section with a way back to the list.
    It fills the application layout, which keeps the head and the navigation.
    Everything sits in the frame "settings_dialog": opened from the account menu, the settings load into the window
    of the same name (shared/_settings_dialog), where their links and forms stay. There (settings_in_dialog?),
    two panels of the whole height take the place of the centered page (settings_layout_classes).
    On the page, the frame targets the whole page (settings_frame_target): its links and forms change the address
    and the whole page, the language form included.
    lang: the language of these settings; the window compares it with the page's when it closes, and reloads the page
    behind it when the language was changed inside it (settings_dialog_controller.js) %>
<% content_for :full_width_page do %>
  <%= turbo_frame_tag "settings_dialog", class: "block h-full", target: settings_frame_target do %>
    <div class="<%= settings_layout_classes(:grid) %>" lang="<%= I18n.locale %>" data-settings-language>
      <%= render "settings/sections_menu" %>
      <main class="<%= settings_layout_classes(:main) %> <%= settings_section_visibility_classes %>">
        <%# Back to the list of sections, on a phone page. The window keeps its menu beside the section %>
        <% unless settings_in_dialog? %>
          <%= link_to settings_path, class: "mb-4 inline-flex items-center gap-1 text-sm font-medium text-muted hover:text-ink md:hidden" do %>
            <%= render "shared/icons/chevron_down", css_class: "size-4 rotate-90" %>
            <%= t(".back_to_settings") %>
          <% end %>
        <% end %>
        <%# The messages are shown inside the section card (settings/_section) %>
        <%= yield %>
      </main>
    </div>
  <% end %>
<% end %>
<%= render template: "layouts/application" %>
