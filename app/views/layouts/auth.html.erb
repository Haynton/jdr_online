<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Visitor pages (sign in, sign up, passwords): no navbar, only the logo and the theme control, across the whole
      width with the margins of the top bar of the home page. The form sits in the middle of the screen:
      the bottom padding makes up for the header, so that it is centered on the screen and not under the header %>
  <body class="flex min-h-dvh flex-col bg-page text-ink">
    <header class="flex items-center justify-between gap-4 px-4 py-4 sm:px-8 lg:px-12">
      <%= link_to root_path, class: "rounded-md" do %>
        <%= render "shared/logo" %>
      <% end %>
      <%= render "shared/theme_selector", compact: true %>
    </header>

    <main class="mx-auto flex w-full max-w-[400px] flex-1 flex-col justify-center px-4 pt-6 pb-12 md:pb-[calc(3rem+4.5rem)]">
      <%# Space between a message and the title, none without a message (the form stays in the middle) %>
      <div class="<%= auth_messages_classes %>">
        <%= render "shared/flashes" %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
