<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Visitor pages (sign in, sign up, passwords): no navbar, only the logo and the theme control %>
  <body class="min-h-screen bg-page text-ink">
    <header class="flex items-center justify-between gap-4 px-4 py-4 sm:px-8">
      <%= link_to root_path, class: "rounded-md" do %>
        <%= render "shared/logo" %>
      <% end %>
      <%= render "shared/theme_selector" %>
    </header>

    <main class="mx-auto w-full max-w-[420px] px-4 pt-8 pb-12">
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>
  </body>
</html>
