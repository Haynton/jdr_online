<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-screen <%= page_background_class %> text-ink">
    <%# A signed in user gets the side navigation, like an app; a visitor keeps the top bar %>
    <%= render(user_signed_in? ? "shared/side_nav" : "shared/navbar") %>

    <div class="<%= page_shell_classes %>">
      <%# A nested layout (layouts/settings) or a dashboard (My tables) can take the whole width beside the navigation %>
      <% if content_for?(:full_width_page) %>
        <%= yield :full_width_page %>
      <% else %>
        <div class="mx-4">
          <%= render "shared/flashes" %>
        </div>
        <main class="mx-auto max-w-[1120px] px-4 py-10 sm:px-8">
          <%= yield %>
        </main>
      <% end %>
    </div>

    <%= render "shared/settings_dialog" if settings_dialog_available? %>
    <%= render "shared/confirm_dialog" if user_signed_in? %>
  </body>
</html>
