<%# Use the settings_panel helper (app/helpers/settings_helper.rb), not this partial directly.
    Two columns from 768 px. On a phone, the section menu goes above the section and scrolls sideways %>
<div class="overflow-hidden rounded-xl border border-line bg-surface md:grid md:grid-cols-[280px_1fr]">
  <nav class="border-b border-line bg-page p-4 md:border-r md:border-b-0 md:p-5" aria-labelledby="settings-title">
    <h1 id="settings-title" class="px-4 text-xl font-bold text-ink"><%= t(".title") %></h1>
    <ul class="mt-3 flex gap-1 overflow-x-auto md:flex-col">
      <li><%= settings_link_to t(".display"), settings_display_path %></li>
      <%# The old account page, until the account section exists (feature/p1-account-security) %>
      <li><%= settings_link_to t(".account"), edit_user_registration_path %></li>
    </ul>
  </nav>

  <section aria-labelledby="settings-section-title">
    <header class="border-b border-line px-6 py-5 sm:px-8">
      <h2 id="settings-section-title" class="text-2xl font-bold text-ink"><%= section_title %></h2>
    </header>
    <div class="px-6 py-6 sm:px-8">
      <%= content %>
    </div>
  </section>
</div>
