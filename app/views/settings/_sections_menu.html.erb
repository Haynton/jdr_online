<%# Section menu of the settings (layouts/settings). On a phone, a list in a card, one row per section;
    from 768 px, a side menu on the page background. In the settings window, the side menu at any width %>
<nav class="<%= settings_menu_visibility_classes %> <%= settings_layout_classes(:menu) %>" aria-labelledby="settings-title">
  <%# In the settings window, the title bar of the window shows it (settings_layout_classes) %>
  <h1 id="settings-title" class="<%= settings_layout_classes(:menu_title) %>"><%= t(".title") %></h1>
  <ul class="<%= settings_layout_classes(:menu_list) %>">
    <%# On /settings (sections controller), the display section is the one shown on a wide screen %>
    <li><%= settings_link_to t(".display"), settings_display_path, current: current_settings_section?(:display) %></li>
    <li><%= settings_link_to t(".account"), settings_account_path, current: current_settings_section?(:account) %></li>
    <li><%= settings_link_to t(".security"), settings_security_path, current: current_settings_section?(:security) %></li>
  </ul>
</nav>
