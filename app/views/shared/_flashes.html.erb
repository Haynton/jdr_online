<% if notice %>
  <div class="mx-4 mt-4 rounded-md border border-success-line bg-success-bg px-4 py-3 text-sm text-success-ink" role="status">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mx-4 mt-4 rounded-md border border-error-line bg-error-bg px-4 py-3 text-sm text-error-ink" role="alert">
    <%= alert %>
  </div>
<% end %>
