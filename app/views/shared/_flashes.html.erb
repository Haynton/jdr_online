<%# The messages shown on screen float above the page (shared/_toast): they never push its content down.
    Wherever this partial is rendered, they land in the same corner of the screen %>
<% if visible_messages? %>
  <div class="<%= toast_stack_classes %>">
    <% visible_flash_messages.each do |variant, message| %>
      <%= render "shared/toast", variant: variant, message: message %>
    <% end %>
  </div>
<% end %>
<%# A message that only repeats what the page shows (see ScreenReaderNotice): for screen readers only %>
<% if flash[:screen_reader_notice] %>
  <div class="sr-only">
    <%= render layout: "shared/message", locals: { variant: :success } do %><%= flash[:screen_reader_notice] %><% end %>
  </div>
<% end %>
