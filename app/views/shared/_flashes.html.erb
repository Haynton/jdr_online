<% if notice %>
  <div class="mx-4 mt-4">
    <%= render layout: "shared/message", locals: { variant: :success } do %><%= notice %><% end %>
  </div>
<% end %>
<% if alert %>
  <div class="mx-4 mt-4">
    <%= render layout: "shared/message", locals: { variant: :error } do %><%= alert %><% end %>
  </div>
<% end %>
