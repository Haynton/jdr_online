<% if notice %>
  <div class="mx-4 mt-4 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mx-4 mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="alert">
    <%= alert %>
  </div>
<% end %>
