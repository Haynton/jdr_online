<%# Light or dark only: the system choice will come back in the settings page (feature/p1-account-settings) %>
<%= render "shared/theme_switch" %>

<%# On a wide screen: "My account", then the avatar next to the email %>
<span class="hidden sm:block">
  <%= nav_link_to t(".my_account"), edit_user_registration_path, current: account_page? %>
</span>
<span class="hidden items-center gap-2 sm:flex">
  <%= render "shared/avatar", user: current_user %>
  <span class="text-sm text-muted"><%= current_user.email %></span>
</span>

<%# On a phone, there is no room for both: the avatar alone is the link to the account %>
<%= link_to edit_user_registration_path,
            class: "rounded-full sm:hidden aria-[current=page]:ring-2 aria-[current=page]:ring-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring",
            aria: { label: t(".my_account"), **current_page_aria(account_page?) } do %>
  <%= render "shared/avatar", user: current_user %>
<% end %>

<%# Temporary: log out moves to the settings page (feature/p1-account-settings). Icon only on a phone %>
<%= button_to destroy_user_session_path, method: :delete, class: button_classes(:quiet, size: :compact) do %>
  <%= render "shared/icons/log_out", css_class: "size-4 sm:hidden" %>
  <span class="sr-only sm:not-sr-only"><%= t(".log_out") %></span>
<% end %>
