<%# Rendered by PasswordInput (app/inputs/password_input.rb) in every password field.
    Hidden until password_visibility_controller.js runs: without JavaScript, it would do nothing.
    The label stays the same, aria-pressed tells whether the password is shown. %>
<button type="button" hidden
        class="absolute top-1/2 right-1 inline-flex size-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-md text-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-focus-ring"
        aria-label="<%= t(".show_password") %>"
        aria-pressed="false"
        data-password-visibility-target="button"
        data-action="password-visibility#toggle">
  <span data-password-visibility-target="showIcon"><%= render "shared/icons/eye", css_class: "size-5" %></span>
  <span data-password-visibility-target="hideIcon" hidden><%= render "shared/icons/eye_off", css_class: "size-5" %></span>
</button>
