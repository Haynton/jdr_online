<%# Navigation of a signed in user, like an app. One element for both shapes:
    on a phone, a floating bar of icons centered above the bottom of the screen (under the thumb, always in view);
    from 768 px, a bar on the left, folded to its icons by default (64 px) and unfolded with its labels (240 px)
    by the button under the logo (side_nav_controller.js). Only the logo and that button at the top; "My tables",
    "My characters", "My templates" and the account entries (shared/_account_nav) sit together at the foot (decision).
    The labels stay for screen readers. The logo is left out on a phone: "My tables" already leads to the same page.
    The width slides open in 200 ms, the page beside it too (page_shell_classes); the texts stay on one line, cut by
    the edge of their link, and fade in once the bar is wide (side_nav_fading_text_classes) %>
<nav id="side-nav"
     class="fixed bottom-4 left-1/2 z-20 flex h-14 -translate-x-1/2 items-center gap-1 rounded-full border border-line bg-surface px-1.5 shadow-lg md:inset-y-0 md:left-0 md:h-auto md:w-16 md:translate-x-0 md:flex-col md:items-stretch md:justify-start md:gap-1.5 md:rounded-none md:border-0 md:border-r md:px-0 md:py-4 md:shadow-none md:nav-expanded:w-60 motion-safe:md:transition-[width] motion-safe:md:duration-200 motion-safe:md:ease-out"
     aria-label="<%= t(".label") %>"
     data-controller="side-nav"
     data-side-nav-expand-label-value="<%= t(".expand") %>"
     data-side-nav-collapse-label-value="<%= t(".collapse") %>">
  <%= link_to logo_path, class: "mx-3 mb-3 hidden overflow-hidden rounded-md px-1 md:flex" do %>
    <%= render "shared/logo", with_side_nav: true %>
  <% end %>

  <%# Right under the logo. Its name says what a click does: "Expand the menu" while folded (read by screen readers,
      shown as a tooltip), "Collapse the menu", written out, once unfolded. The controller keeps the tooltip in step.
      "Collapse" is invisible, not only transparent, while folded: the button would otherwise be named by both %>
  <div class="hidden md:mb-3 md:block md:px-3">
    <button type="button" hidden
            class="flex h-10 w-full items-center gap-3 overflow-hidden rounded-lg px-2.5 text-muted transition-colors hover:bg-surface-raised hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
            title="<%= t(".expand") %>"
            aria-controls="side-nav"
            data-side-nav-target="toggleButton"
            data-action="side-nav#toggle">
      <%= nav_icon("panel_left") %>
      <span class="sr-only nav-expanded:hidden"><%= t(".expand") %></span>
      <span class="invisible text-[15px] nav-expanded:visible <%= side_nav_fading_text_classes %> motion-safe:md:transition-[opacity,visibility]"><%= t(".collapse") %></span>
    </button>
  </div>

  <%# md:mt-auto: from here on, pushed to the foot of the bar. Side by side in the floating bar of a phone, with the
      same gaps as the bar itself; one under the other from 768 px %>
  <div class="flex items-center gap-1 md:mt-auto md:flex-col md:items-stretch md:gap-1.5">
    <%# The invitations waiting for an answer show on "My tables", where the player answers them %>
    <%= side_nav_link_with_count_to t(".my_tables"), game_tables_path, icon: "scroll_text",
                                    count: pending_invitations_count,
                                    count_label: t(".pending_invitations", count: pending_invitations_count) %>
    <%# The characters of the player, on all their tables, current on the page of one of them too %>
    <%= side_nav_link_to t(".my_characters"), characters_path, icon: "venetian_mask",
                         current: characters_page? %>
    <%# The templates of the game master, current on the page of one of them too %>
    <%= side_nav_link_to t(".my_templates"), sheet_templates_path, icon: "library_big",
                         current: sheet_templates_page? %>
    <%# The maps of the game master, current on the page of one of them too %>
    <%= side_nav_link_to t(".my_maps"), map_templates_path, icon: "map", current: map_templates_page? %>
  </div>

  <%= render "shared/account_nav" %>
</nav>
