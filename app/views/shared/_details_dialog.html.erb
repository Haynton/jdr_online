<%# The window of the details of a spell or an item, one per page, inside the element that carries
    data-controller="details-dialog" (the Spells step, the summary sheet): empty until a "Details" button is clicked,
    then details_dialog_controller.js writes the name and the line of the entry in its title bar and copies its details
    (rendered beside the button, folded) under it. Centered, 640 px wide at most, as tall as its text up to the screen:
    only the text scrolls. Escape, the cross or a click beside it close it, and the focus goes back to the button.
    id: another id when a page holds two (the spells chosen in the game room, beside the window of the room) %>
<% dialog_id = local_assigns.fetch(:id, "details-dialog") %>
<dialog id="<%= dialog_id %>" aria-labelledby="<%= dialog_id %>-title" tabindex="-1"
        class="m-auto max-h-[min(760px,calc(100dvh-2rem))] w-[min(640px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl outline-none backdrop:bg-black/50 open:flex"
        data-details-dialog-target="dialog"
        data-action="click->details-dialog#closeOnBackdrop cancel->details-dialog#cancelled close->details-dialog#returnFocus turbo:before-cache@document->details-dialog#close">
  <header class="flex shrink-0 items-start justify-between gap-4 border-b border-line py-4 pr-3 pl-6">
    <div class="min-w-0">
      <h2 id="<%= dialog_id %>-title" class="text-lg font-semibold text-ink" data-details-dialog-target="title"></h2>
      <p class="text-sm text-muted" data-details-dialog-target="summary"></p>
    </div>
    <button type="button" class="<%= button_classes(:quiet, size: :compact_icon) %>"
            aria-label="<%= t("shared.details_dialog.close") %>" title="<%= t("shared.details_dialog.close") %>"
            data-action="details-dialog#close">
      <%= render "shared/icons/x", css_class: "size-5" %>
    </button>
  </header>
  <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5 text-[15px]" data-details-dialog-target="body"></div>
</dialog>
