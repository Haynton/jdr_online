<%# The question asked before an action that cannot be undone at once (log out, delete the account), instead of the
    plain window of the browser: Turbo hands every data-turbo-confirm to confirm_dialog.js, which fills and opens it.
    The question is the title; the confirm button says the action (data-confirm-button of the form or its button,
    "Confirm" otherwise), in red for data-confirm-variant="danger". Both looks are written here in full
    (data-*-classes): no class built from pieces in JavaScript. Escape, Cancel or a click beside it answer no.
    A native <dialog>: the focus stays inside, the page behind is inert; Cancel takes the focus first %>
<dialog id="confirm-dialog" aria-labelledby="confirm-dialog-question"
        class="m-auto w-[min(400px,calc(100vw-2rem))] rounded-2xl border border-line bg-surface p-6 text-ink shadow-2xl backdrop:bg-black/50"
        data-primary-classes="<%= button_classes(:primary) %>"
        data-danger-classes="<%= button_classes(:danger) %>"
        data-default-label="<%= t(".confirm") %>">
  <form method="dialog">
    <p id="confirm-dialog-question" class="text-base font-semibold text-ink"></p>
    <div class="mt-6 flex justify-end gap-3">
      <button type="submit" value="cancel" class="<%= button_classes(:secondary) %>"><%= t(".cancel") %></button>
      <button type="submit" value="confirm" class="<%= button_classes(:primary) %>" data-confirm-dialog-button></button>
    </div>
  </form>
</dialog>
