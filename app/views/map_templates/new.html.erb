<%# A new map: its name, then the size of its grid, chosen here only (the cells drawn outside a smaller grid would be
    lost). Cancel and Create at the bottom right, like the pages of a creation %>
<%= map_template_page do %>
  <%= page_header(title: t(".title"), subtitle: t(".subtitle")) %>

  <%= simple_form_for @map_template, html: { id: "new-map-template-form", class: "flex flex-1 flex-col" },
                                     defaults: { wrapper_html: { class: "max-w-sm" } } do |form| %>
    <%= form_error_notification(form) %>
    <%= form.input :name, required: true, input_html: { autocomplete: "off", maxlength: MapTemplate::NAME_MAX_LENGTH } %>
    <div class="grid max-w-sm grid-cols-2 gap-x-4">
      <% %i[columns rows].each do |dimension| %>
        <%= form.input dimension, required: true,
                                  input_html: { min: MapTemplate::GRID_SIZES.min, max: MapTemplate::GRID_SIZES.max } %>
      <% end %>
    </div>
    <p class="max-w-sm text-sm text-muted"><%= t(".size_hint") %></p>

    <div class="mt-auto flex flex-wrap justify-end gap-3 pt-10">
      <%= link_to t(".cancel"), map_templates_path, class: button_classes(:secondary) %>
      <%= form.button :submit, t(".create"), class: button_classes(:primary) %>
    </div>
  <% end %>
<% end %>
