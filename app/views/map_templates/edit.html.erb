<%# The page of a map is the map editor, across the whole screen beside the navigation, like the prototype
    (docs/prototypes/map-editor.html): see map_templates/_editor. Renaming saves when the field is left and the page
    refreshes by morphing; the editor draws itself again then (turbo:morph) %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% content_for :full_width_page do %>
  <%= render "map_templates/editor", map_template: @map_template %>
<% end %>
