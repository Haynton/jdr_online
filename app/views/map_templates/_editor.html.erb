<%# The map editor (map_editor_controller.js), laid out like the prototype: a bar on top (the map, the way of making
    it, the tools, the figures of the drawing), the board filling the room left on a deeper background (well), its
    help and zoom floating over it, a panel of 340 px on the right: tabs (the maps ready to use, the floors and walls,
    the objects). The map is deleted from « Mes cartes ». From 1024 px the editor holds in the screen; before, the
    bar, the board at the width of the screen, then the panel. The board keeps the colors of its drawing in the dark
    theme, like a picture. Board and tools are rendered hidden and shown by the controller: without JavaScript there
    is nothing to draw with %>
<main class="flex min-h-[calc(100dvh-5rem)] flex-col md:min-h-dvh lg:h-dvh" <%= tag.attributes(data: map_editor_data(map_template)) %>>
  <%= render "shared/flashes" %>
  <%# From 1024 px, three columns: the name on the left, the way of making the map and the tools in the middle of the
      bar (Anthony's request), an empty column on the right to keep them there. The left one is at least as wide as the
      name: on a narrow screen the middle moves right rather than over the name %>
  <header class="flex flex-wrap items-center gap-x-3 gap-y-2.5 border-b border-line bg-surface px-4 py-3 sm:px-6 lg:grid lg:min-h-16 lg:grid-cols-[minmax(max-content,1fr)_auto_1fr] lg:py-2">
    <%# The name, changed right here (it looks like a title until it is pointed at). The size of the grid floats over
        the board (map_templates/_grid_size) %>
    <div class="flex min-w-0 basis-full items-center lg:basis-auto lg:flex-none">
      <h1 class="sr-only"><%= map_template.name_in_database %></h1>
      <%= render "map_templates/name_form", map_template: map_template %>
    </div>
    <%# On a phone (under 640 px), one row each across the whole width (Anthony's request): the way of making the map
        in two halves, then the tools in buttons of the same width, without their separator %>
    <div class="flex w-full flex-wrap items-center gap-x-3 gap-y-2.5 lg:w-auto lg:flex-nowrap">
      <%# How the map is made, in the bar (Anthony's request): Draw, or a picture %>
      <%= render "map_templates/making_choices", map_template: map_template %>
      <div hidden class="flex w-full items-center gap-1.5 max-sm:[&_button]:flex-1 sm:w-auto sm:gap-1" role="toolbar" aria-label="<%= t(".actions_label") %>" data-map-editor-target="toolbar">
        <%# Disabled while there is nothing to undo, to redo, to clear (the controller says so) %>
        <button type="button" disabled class="<%= MapTemplatesHelper::MAP_BAR_TOOL_CLASSES %>" title="<%= t(".undo_keys") %>"
                data-map-editor-target="undoButton" data-action="map-editor#undo">
          <%= render "shared/icons/undo_2", css_class: "size-4" %><span class="<%= MapTemplatesHelper::MAP_BAR_LABEL_CLASSES %>"><%= t(".undo") %></span>
        </button>
        <button type="button" disabled class="<%= MapTemplatesHelper::MAP_BAR_TOOL_CLASSES %>" title="<%= t(".redo_keys") %>"
                data-map-editor-target="redoButton" data-action="map-editor#redo">
          <%= render "shared/icons/redo_2", css_class: "size-4" %><span class="<%= MapTemplatesHelper::MAP_BAR_LABEL_CLASSES %>"><%= t(".redo") %></span>
        </button>
        <%# The tools of the drawing: not for a map played on a picture (data-picture, set by the editor). From 1024 px
            they keep their room, invisible, so that the switch in the middle of the bar does not move (Anthony's
            request); under it, where the switch does not move with them, they go %>
        <div class="contents data-picture:max-lg:hidden data-picture:lg:invisible" data-map-editor-target="drawingTools">
          <span class="mx-1 h-6 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
          <%# The hand: the main button moves the map instead of drawing (Anthony's request: with a mouse, holding space
              was a chore). Clicked again, or H, gives back the tool used before %>
          <%= render "map_templates/tool", kind: "hand", key: "hand", label: t(".hand"), in_bar: true,
                                           icon: render("shared/icons/hand", css_class: "size-4") %>
          <%# The direction of the next object put: its degrees only in its tooltip, written by the controller (Anthony's
              request: in its label, they changed the width of the button) %>
          <button type="button" class="<%= MapTemplatesHelper::MAP_BAR_TOOL_CLASSES %>" data-action="map-editor#rotatePlacement"
                  title="<%= t(".rotate", degrees: 0) %>" data-map-editor-target="rotationLabel">
            <%= render "shared/icons/rotate_cw", css_class: "size-4" %>
            <span class="<%= MapTemplatesHelper::MAP_BAR_LABEL_CLASSES %>"><%= t(".rotate_short") %></span>
          </button>
          <%= render "map_templates/tool", kind: "remover", key: "remover", label: t(".remove_object"), in_bar: true,
                                           icon: render("shared/icons/package_x", css_class: "size-4") %>
          <%= render "map_templates/tool", kind: "eraser", key: "eraser", label: t(".eraser"), in_bar: true,
                                           icon: render("shared/icons/eraser", css_class: "size-4") %>
          <%# Asked first in the window of confirmation (Anthony's request) %>
          <button type="button" disabled class="<%= MapTemplatesHelper::MAP_BAR_TOOL_CLASSES %>" title="<%= t(".clear_hint") %>"
                  data-map-editor-target="clearButton" data-action="map-editor#clearEverything"
                  data-confirm-button="<%= t(".clear_button") %>" data-confirm-variant="danger">
            <%= render "shared/icons/brush_cleaning", css_class: "size-4" %><span class="<%= MapTemplatesHelper::MAP_BAR_LABEL_CLASSES %>"><%= t(".clear") %></span>
          </button>
        </div>
        <%# A map of a table only (blocking:): the brush that paints the cells no token stands on, drawn or on a
            picture (Anthony's decision: the game master paints them, nothing else blocks but the empty ground and the
            walls of rooms and stones). Clicked again, it gives back the tool used before %>
        <% if map_editor_blocking?(map_template) %>
          <span class="mx-1 h-6 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
          <%= render "map_templates/tool", kind: "blocker", key: "blocker", label: t(".blocked_zones"), in_bar: true,
                                           icon: render("shared/icons/ban", css_class: "size-4") %>
        <% end %>
      </div>
    </div>
    <%# A map of a table goes back to the step Maps of its table (back_path:); a map of « Mes cartes », by the
        navigation %>
    <% if local_assigns[:back_path] %>
      <%= link_to local_assigns[:back_path], class: "#{button_classes(:secondary, size: :compact)} lg:justify-self-end" do %>
        <%= render "shared/icons/chevron_left" %><%= local_assigns[:back_label] %>
      <% end %>
    <% end %>
  </header>

  <div class="grid min-h-0 flex-1 lg:grid-cols-[minmax(0,1fr)_340px]">
    <%# The board fills the room, a thin margin of the deeper background around it, like the prototype: the whole
        map at first, then zoomed and moved (map_editor/board_view.js). 65 % of the height of a phone %>
    <div class="relative flex h-[65dvh] min-h-0 min-w-0 flex-col overflow-hidden bg-well p-2 lg:h-auto lg:p-3">
      <%# touch-none: on a phone, a finger draws instead of scrolling the page %>
      <svg hidden role="img" aria-label="<%= t(".board_label", name: map_template.name_in_database) %>"
           class="block min-h-0 w-full flex-1 cursor-crosshair touch-none rounded-lg shadow-lg select-none"
           data-map-editor-target="board"
           data-action="pointerdown->map-editor#startStroke pointermove->map-editor#continueStroke pointerup->map-editor#endStroke pointercancel->map-editor#endStroke pointerenter->map-editor#enterBoard pointerleave->map-editor#hidePointer wheel->map-editor#zoomOrMoveWithWheel:!passive gesturestart->map-editor#startGesture:!passive gesturechange->map-editor#zoomWithGesture:!passive gestureend->map-editor#startGesture:!passive keydown.space@window->map-editor#holdSpace keyup.space@window->map-editor#releaseSpace keydown@window->map-editor#undoWithKeys keydown.r@window->map-editor#rotateWithKey keydown.h@window->map-editor#chooseHandWithKey keydown@window->map-editor#deleteWithKey contextmenu->map-editor#dropToolWithRightClick">
        <g data-map-editor-target="drawing"></g>
        <g pointer-events="none" data-map-editor-target="pointerMarks"></g>
      </svg>
      <%= render "map_templates/grid_size", map_template: map_template %>
      <%# Floating at the bottom left of the board, across from the zoom (the bar had no room left for it once the way
          of making the map joined it): when the drawing was saved (a failed save in red, said to screen readers),
          then its figures %>
      <%# Hidden while it has nothing to show (nothing saved yet on a map played on a picture) %>
      <div class="pointer-events-none absolute bottom-5 left-5 max-w-[calc(100%-6rem)] rounded-lg bg-surface/90 px-2.5 py-1.5 text-[11px] leading-snug shadow-md lg:bottom-6 lg:left-6 [&:not(:has(p:not([hidden]):not(:empty)))]:hidden">
        <p class="text-muted empty:hidden" data-map-editor-target="saveState"></p>
        <p class="text-error-ink empty:hidden" role="status" data-map-editor-target="status"></p>
        <p class="text-muted" data-map-editor-target="figures"></p>
      </div>
      <%# Round buttons floating at the bottom right of the board (Anthony's requests): the help, then the zoom, the
          whole map at the foot. In the board: on a phone, above the floating bar of the navigation %>
      <div class="absolute right-5 bottom-5 flex flex-col items-end gap-4 lg:right-6 lg:bottom-6">
        <%= render "map_templates/help", table: map_editor_blocking?(map_template) %>
        <div hidden class="flex flex-col gap-2" role="group"
             aria-label="<%= t(".zoom_label") %>" data-map-editor-target="zoomButtons">
          <% [["zoomIn", t(".zoom_in"), "plus"], ["zoomOut", t(".zoom_out"), "minus"], ["showWholeMap", t(".whole_map"), "maximize"]].each do |action, label, icon| %>
            <button type="button" class="<%= MapTemplatesHelper::MAP_FLOATING_BUTTON_CLASSES %>" data-action="map-editor#<%= action %>"
                    aria-label="<%= label %>" title="<%= label %>"><%= render MapTemplatesHelper::ZOOM_ICON_PARTIALS.fetch(icon), css_class: "size-4" %></button>
          <% end %>
        </div>
      </div>
      <noscript><p class="text-sm text-ink"><%= t(".needs_javascript") %></p></noscript>
    </div>

    <%# The panel: the tabs of the drawing, or the picture of the map, by the way it is made (shown by the editor when
        the switch of the bar changes it) %>
    <aside class="flex min-h-0 flex-col border-t border-line bg-surface lg:border-t-0 lg:border-l" aria-label="<%= t(".panel_label") %>">
      <div <%= "hidden" if map_picture_mode?(map_template) %> class="flex min-h-0 flex-1 flex-col" data-map-editor-target="drawingPanel"
           data-controller="tabs" data-action="turbo:morph@document->tabs#refresh"
           data-tabs-selected-index-value="<%= map_editor_first_tab_index(map_template) %>">
        <div hidden role="tablist" aria-label="<%= t(".tabs_label") %>" class="mt-3 flex gap-0.5 border-b border-line px-3" data-tabs-target="list">
          <% map_editor_tabs(map_template).each do |panel, label| %>
            <button type="button" role="tab" id="map-editor-tab-<%= panel %>" aria-controls="map-editor-panel-<%= panel %>"
                    aria-selected="false" class="<%= MapTemplatesHelper::MAP_TAB_CLASSES %>"
                    data-tabs-target="tab" data-action="tabs#choose keydown->tabs#moveWithKeys"><%= label %></button>
          <% end %>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-3.5 py-3">
          <section id="map-editor-panel-presets" role="tabpanel" aria-labelledby="map-editor-tab-presets" data-tabs-target="panel">
            <%= render "map_templates/preset_tools" %>
          </section>
          <section id="map-editor-panel-floors" role="tabpanel" aria-labelledby="map-editor-tab-floors" data-tabs-target="panel">
            <%= render "map_templates/floor_tools" %>
          </section>
          <section id="map-editor-panel-objects" role="tabpanel" aria-labelledby="map-editor-tab-objects" data-tabs-target="panel">
            <%= render "map_templates/object_tools" %>
          </section>
          <% if map_editor_blocking?(map_template) %>
            <section id="map-editor-panel-tokens" role="tabpanel" aria-labelledby="map-editor-tab-tokens" data-tabs-target="panel">
              <%= render "map_templates/token_tools", map_template: map_template, prefix: "drawing" %>
            </section>
          <% end %>
        </div>
      </div>

      <div <%= "hidden" unless map_picture_mode?(map_template) %> class="min-h-0 flex-1 overflow-y-auto px-3.5 py-4"
           data-map-editor-target="picturePanel">
        <%= render "map_templates/picture_tools", map_template: map_template %>
        <%# On a picture too, the tokens of a map of a table, under its settings %>
        <% if map_editor_blocking?(map_template) %>
          <section class="mt-6" aria-labelledby="map-picture-tokens-title">
            <h2 id="map-picture-tokens-title" class="mb-2 text-[11px] font-bold tracking-widest text-brass uppercase"><%= t(".tokens_tab") %></h2>
            <%= render "map_templates/token_tools", map_template: map_template, prefix: "picture" %>
          </section>
        <% end %>
      </div>
    </aside>
  </div>
</main>
