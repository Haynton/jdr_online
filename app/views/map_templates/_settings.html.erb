<%# The tab of the map itself: its deletion, asked first. Its name and its size are changed in the bar on top %>
<h2 class="mb-2 text-[11px] font-bold tracking-widest text-brass uppercase"><%= t(".title") %></h2>
<section aria-labelledby="map-delete-title">
  <h3 id="map-delete-title" class="text-sm font-semibold text-ink"><%= t(".delete") %></h3>
  <p class="mt-1 text-xs text-muted"><%= t(".delete_description") %></p>
  <%# Asked first (shared/_confirm_dialog), with a red confirm button %>
  <%= button_to t(".delete_button"), map_template_path(map_template), method: :delete,
                form_class: "mt-3", class: button_classes(:danger, size: :compact),
                data: { turbo_confirm: t(".delete_confirmation", name: map_template.name_in_database),
                        confirm_button: t(".delete_button"), confirm_variant: "danger" } %>
</section>
