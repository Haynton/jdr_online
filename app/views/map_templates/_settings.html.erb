<%# The tab of the map itself: its name, saved when the field is left (auto_submit_controller.js; the page refreshes
    by morphing), then its deletion, asked first (out of the form: a form inside a form is not allowed) %>
<h2 class="mb-2 text-[11px] font-bold tracking-widest text-brass uppercase"><%= t(".title") %></h2>
<%= simple_form_for map_template, html: { id: "map-template-form",
                                          data: { controller: "auto-submit", action: "change->auto-submit#submit" } } do |form| %>
  <%= form_error_notification(form) %>
  <%= form.input :name, required: true, input_html: { autocomplete: "off", maxlength: MapTemplate::NAME_MAX_LENGTH } %>
  <%# Without JavaScript, nothing saves by itself %>
  <noscript>
    <%= form.button :submit, t(".save"), class: button_classes(:secondary) %>
  </noscript>
<% end %>

<section class="mt-6" aria-labelledby="map-delete-title">
  <h3 id="map-delete-title" class="text-sm font-semibold text-ink"><%= t(".delete") %></h3>
  <p class="mt-1 text-xs text-muted"><%= t(".delete_description") %></p>
  <%# Asked first (shared/_confirm_dialog), with a red confirm button %>
  <%= button_to t(".delete_button"), map_template_path(map_template), method: :delete,
                form_class: "mt-3", class: button_classes(:danger, size: :compact),
                data: { turbo_confirm: t(".delete_confirmation", name: map_template.name_in_database),
                        confirm_button: t(".delete_button"), confirm_variant: "danger" } %>
</section>
