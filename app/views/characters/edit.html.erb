<%# The identity and the description of a complete character (CharacterDescription, decision): its name and the fields
    that change nothing worked out, by section, drawn by the fields of the creation steps (characters/
    _description_form). Cancel goes back to its sheet without saving, Save saves and shows it. Refused, the errors show
    under their fields. From the game room, « Modifier ma fiche » (panel « Ma fiche ») opens it in the window of the
    sheet (decision of 26 November: the player never leaves the game), with a title bar and the cross; saved, the
    window closes and the room shows the change; the forms of the picture then stay in the frame. Elsewhere, a page %>
<% name = @character.name_in_database.presence || t("game_tables.character_steps.summary.unnamed") %>
<% if character_sheet_in_dialog? %>
  <%= turbo_frame_tag GameRoomHelper::SHEET_FRAME, class: "flex min-h-0 flex-1 flex-col" do %>
    <header class="flex shrink-0 items-start justify-between gap-4 border-b border-line py-4 pr-3 pl-6">
      <div class="min-w-0">
        <h2 id="character-sheet-dialog-title" class="truncate text-lg font-semibold text-ink"><%= t(".title", name: name) %></h2>
        <p class="text-sm text-muted"><%= t(".subtitle", name: @character.game_table.name) %></p>
      </div>
      <button type="button" class="<%= button_classes(:quiet, size: :compact_icon) %>"
              aria-label="<%= t("game_tables.character_sheets.show.close") %>"
              title="<%= t("game_tables.character_sheets.show.close") %>" data-action="frame-dialog#close">
        <%= render "shared/icons/x", css_class: "size-5" %>
      </button>
    </header>
    <%= render "characters/description_form", character: @character, in_dialog: true %>
    <%= content_for :detached_forms %>
  <% end %>
<% else %>
  <% content_for :full_width_page do %>
    <main class="flex min-h-[calc(100dvh-5rem)] flex-col px-4 pt-8 pb-12 sm:px-8 md:min-h-dvh">
      <%= render "shared/flashes" %>
      <%= page_header(title: t(".title", name: name), subtitle: t(".subtitle", name: @character.game_table.name)) %>
      <%= render "characters/description_form", character: @character, cancel_path: character_path(@character) %>
    </main>
  <% end %>
<% end %>
