<%# The template editor, the form of a field (sheet_templates/fields/_form). Asked for the window of the creation path
    (SheetTemplates::FieldDialogHelper): its title bar (the name of the field, its type and section, the close cross)
    and the form, in the frame of the window. Opened directly, or without JavaScript: a page of the editor %>
<% subtitle = t(".subtitle", type: field_type_name(@field).upcase_first, section: @field["section"]) %>
<% if field_in_dialog? %>
  <%= turbo_frame_tag SheetTemplates::FieldDialogHelper::FRAME, class: "flex min-h-0 flex-1 flex-col" do %>
    <header class="flex shrink-0 items-start justify-between gap-4 border-b border-line py-4 pr-3 pl-6">
      <div class="min-w-0">
        <h2 id="field-dialog-title" class="truncate text-lg font-semibold text-ink"><%= @field["label"] %></h2>
        <p class="text-sm text-muted"><%= subtitle %></p>
      </div>
      <button type="button" class="<%= button_classes(:quiet, size: :compact_icon) %>"
              aria-label="<%= t(".close") %>" title="<%= t(".close") %>" data-action="frame-dialog#close">
        <%= render "shared/icons/x", css_class: "size-5" %>
      </button>
    </header>
    <%= render "sheet_templates/fields/form", sheet_template: @sheet_template, field: @field, context: @form_context,
                                              in_dialog: true %>
  <% end %>
<% else %>
  <%= template_editor_page(sheet_template: @sheet_template, current_step: :creation_path) do %>
    <%= page_header(title: @field["label"], subtitle: subtitle) %>
    <%= render "sheet_templates/fields/form", sheet_template: @sheet_template, field: @field, context: @form_context,
                                              in_dialog: false %>
  <% end %>
<% end %>
