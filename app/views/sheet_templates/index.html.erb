<%# The templates of the game master, laid out like the first step of the creation of a table (decision: not like
    "My tables", so that the two lists are not mixed up): across the whole width, a row of cards for theirs (each a
    link to the editor), then a row for the predefined ones in the language of the page, each with "Duplicate", which
    makes one of theirs from it (decision: a template starts from one that works). While they have none, a dashed
    card says how to start, like the empty spots of "My tables" %>
<%# The main landmark of the page: a page across the whole width carries its own (layouts/application does not) %>
<% content_for :full_width_page do %>
  <main class="px-4 pt-8 pb-12 sm:px-8">
    <%# The messages float above the page (a bubble): rendered here, the layout leaves them to a full width page %>
    <%= render "shared/flashes" %>
    <%= page_header(title: t(".title"), subtitle: t(".subtitle")) %>

    <%= render layout: "game_tables/choice_row", locals: { legend: t(".own_title"), heading_id: "own-templates-title" } do %>
      <% if @own_templates.empty? %>
        <li class="w-[62%] shrink-0 sm:w-56">
          <div class="flex h-full min-h-52 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-field-line bg-surface p-4 text-center">
            <%# Full keys: inside a render layout: block, a short key is looked up under the row partial %>
            <span class="font-semibold text-ink"><%= t("sheet_templates.index.none_title") %></span>
            <span class="text-sm text-muted"><%= t("sheet_templates.index.none") %></span>
          </div>
        </li>
      <% end %>
      <% @own_templates.each do |sheet_template| %>
        <li class="w-[62%] shrink-0 sm:w-56">
          <%= render "sheet_templates/tile", sheet_template: sheet_template, path: sheet_template_path(sheet_template) %>
        </li>
      <% end %>
    <% end %>

    <%= render layout: "game_tables/choice_row",
               locals: { legend: t(".predefined_title"), hint: t(".predefined_hint"),
                         heading_id: "predefined-templates-title" } do %>
      <% @predefined_templates.each do |sheet_template| %>
        <li class="w-[62%] shrink-0 sm:w-56">
          <%= render layout: "sheet_templates/tile", locals: { sheet_template: sheet_template } do %>
            <%# Named with the template: "Duplicate Fantasy héroïque" for a screen reader, among several buttons %>
            <%= button_to sheet_template_duplicate_path(sheet_template), form_class: "mt-auto pt-3",
                          class: button_classes(:secondary, full_width: true),
                          aria: { label: t("sheet_templates.index.duplicate_label", name: sheet_template.name) } do %>
              <%= render "shared/icons/copy" %>
              <%= t("sheet_templates.index.duplicate") %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </main>
<% end %>
