<%# A card of a template, in the rows of "My templates" and like the cards of templates of the creation of a table:
    its icon in the color of its banner, its name on one line, its description on 2 lines. The room of the 2 lines is
    kept without a description (decision: every card the same height; what it holds and where it comes from are on
    its page). Rendered as a layout: the block holds the round button over the picture of a provided template
    (Duplicate); one of mine is a link to its page as a whole (path:) %>
<% path = local_assigns[:path] %>
<%= content_tag (path ? :a : :div), href: path,
                class: (path ? SheetTemplatesHelper::TEMPLATE_LINK_TILE_CLASSES : SheetTemplatesHelper::TEMPLATE_TILE_CLASSES) do %>
  <%# In the color of its banner, chosen in the editor (BANNER_CLASSES) %>
  <span class="flex aspect-video w-full items-center justify-center <%= banner_classes(sheet_template.banner_color, :background) %> <%= banner_classes(sheet_template.banner_color, :accent) %>" aria-hidden="true">
    <%= sheet_template_icon(sheet_template.icon, css_class: "size-10") %>
  </span>
  <span class="flex flex-col gap-1 px-4 pt-3 pb-4">
    <span class="truncate font-semibold text-ink" title="<%= sheet_template.name %>"><%= sheet_template.name %></span>
    <span class="line-clamp-2 min-h-[2lh] text-sm break-words text-ink"><%= sheet_template.description %></span>
  </span>
  <%= yield %>
<% end %>
