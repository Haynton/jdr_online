<%# The template editor, step "Informations", composed like the summary of the creation of a table (decision), compact
    enough to hold in one screen (decision): a banner across the whole width, right under the band of the editor, in the
    color chosen (BANNER_CLASSES), with its icon large and decorative, its name, its description and its figures in
    small boxes; then three columns from 1024 px: its presentation (name, description, icon, color of the banner), the
    tables that use it, its deletion (refused while a table uses it: its tables read its catalog).
    Saved live (decision): a choice saves as soon as it changes, a text when it is left (auto_submit_controller.js),
    and the page refreshes by morphing, keeping its scroll (turbo_refreshes_with): the banner changes under the eye.
    No sentence to say it (decision: the change shows at once on the banner). Without JavaScript, a Save button. On the banner, only ink and its accent (contrast) %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% banner_color = @sheet_template.banner_color_in_database %>
<%= template_editor_page(sheet_template: @sheet_template, current_step: :informations, flush_top: true) do %>
  <section class="relative isolate -mx-4 overflow-hidden px-4 pt-10 pb-8 sm:-mx-8 sm:px-8 <%= banner_classes(banner_color, :background) %>"
           aria-labelledby="template-title">
    <%# Its icon, large and decorative, as the picture of a cover %>
    <%= sheet_template_icon(@sheet_template.icon_in_database, css_class: "pointer-events-none absolute -right-4 -bottom-10 -z-10 size-56 opacity-20 md:right-10 #{banner_classes(banner_color, :accent)}") %>
    <p class="text-xs font-semibold tracking-widest uppercase <%= banner_classes(banner_color, :accent) %>">
      <%= t(".eyebrow") %>
      <% if (origin = sheet_template_origin(@sheet_template)) %>
        · <%= origin %>
      <% end %>
    </p>
    <h1 id="template-title" class="mt-3 text-3xl leading-tight font-bold tracking-tight text-balance text-ink md:text-4xl">
      <%= @sheet_template.name_in_database %>
    </h1>
    <%# Its description, 150 characters at most: its room kept even empty, so that the banner keeps the same height
        (decision): 2 lines from 640 px, 4 on a phone (150 characters take about 3 lines and a half there) %>
    <p id="template-description" class="mt-3 line-clamp-4 min-h-[4lh] max-w-2xl text-[15px] break-words text-ink sm:line-clamp-2 sm:min-h-[2lh]"><%= @sheet_template.description_in_database %></p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="<%= t(".contents_title") %>">
      <% sheet_template_figures(@sheet_template).each do |label, value| %>
        <li class="flex min-w-20 items-baseline gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5">
          <span class="text-base font-bold text-ink tabular-nums"><%= number_with_delimiter(value) %></span>
          <span class="text-[10px] leading-tight font-semibold tracking-wider text-muted uppercase"><%= label %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <%# Three columns without cards nor lines (decisions), one under the other before 1024 px: the template (name,
      description, icon, color of the banner), the tables that use it, its deletion (out of the form: a form inside a
      form is not allowed) %>
  <div class="mt-6 grid gap-x-10 gap-y-8 lg:grid-cols-3">
    <%= simple_form_for @sheet_template, html: { id: "sheet-template-form",
                                                 data: { controller: "auto-submit", action: "change->auto-submit#submit" } },
                                         defaults: { wrapper_html: { class: "max-w-md" } } do |form| %>
      <%= form_error_notification(form) %>
      <section aria-labelledby="template-presentation-title">
        <h2 id="template-presentation-title" class="mb-3 text-base font-semibold text-ink"><%= t(".presentation_title") %></h2>
        <%= form.input :name, required: true, input_html: { autocomplete: "off" } %>
        <%# 3 lines: 150 characters seen at once (maxlength stops the typing there, the model refuses beyond) %>
        <%= form.input :description, input_html: { maxlength: SheetTemplate::DESCRIPTION_MAX_LENGTH, rows: 3, class: "min-h-0" } %>
        <%= render "sheet_templates/icon_choices", form: form, sheet_template: @sheet_template %>
        <%= render "sheet_templates/banner_color_choices", form: form, sheet_template: @sheet_template %>
      </section>
      <%# Without JavaScript, nothing saves by itself %>
      <noscript>
        <%= form.button :submit, t(".save"), class: button_classes(:primary) %>
      </noscript>
    <% end %>

    <%= render "sheet_templates/tables", sheet_template: @sheet_template %>

    <section class="min-w-0" aria-labelledby="template-delete-title">
      <h2 id="template-delete-title" class="text-base font-semibold text-ink"><%= t(".delete") %></h2>
      <% if @sheet_template.used_by_tables? %>
        <p class="mt-1 text-sm text-muted"><%= t(".used_by_tables", count: @sheet_template.game_tables.count) %></p>
      <% else %>
        <p class="mt-1 text-sm text-muted"><%= t(".delete_description") %></p>
        <%# Asked first (shared/_confirm_dialog), with a red confirm button %>
        <%= button_to t(".delete_button"), sheet_template_path(@sheet_template), method: :delete,
                      form_class: "mt-3", class: button_classes(:danger),
                      data: { turbo_confirm: t(".delete_confirmation", name: @sheet_template.name_in_database),
                              confirm_button: t(".delete_button"), confirm_variant: "danger" } %>
      <% end %>
    </section>
  </div>

  <%# At the bottom of the screen when the page is short (mt-auto), on the right, as on the pages of a creation: Back
      (to "My templates") then Next (the creation path), the order of the band %>
  <div class="mt-auto flex flex-wrap justify-end gap-3 pt-8">
    <%= link_to t(".back"), sheet_templates_path, class: button_classes(:secondary) %>
    <%= link_to t(".next"), sheet_template_fields_path(@sheet_template), class: button_classes(:primary) %>
  </div>
<% end %>
