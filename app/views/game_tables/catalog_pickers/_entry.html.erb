<%# One entry of the whole catalog: its name, what it is, and "Customize" (named "Customize Fireball" for screen
    readers), which lists it on the step; "Listed" once it is (id picker-entry-<key>: replaced when it is picked) %>
<li id="picker-entry-<%= entry.key %>" class="flex min-h-14 items-center justify-between gap-4 border-b border-line py-2.5"
    data-catalog-search-target="entry" data-search-name="<%= catalog_search_name(entry) %>">
  <div class="min-w-0">
    <p class="truncate text-sm font-semibold text-ink" title="<%= entry.name %>"><%= entry.name %></p>
    <p class="truncate text-xs text-muted"><%= catalog_entry_detail(entry) %></p>
  </div>
  <% if listed %>
    <span class="inline-flex shrink-0 items-center gap-1.5 text-sm text-muted">
      <%= render "shared/icons/check" %>
      <%= t("game_tables.catalog_pickers.show.listed") %>
    </span>
  <% else %>
    <%= button_to game_table_catalog_entries_path(@game_table, kind: entry.kind), params: { from_key: entry.key },
                  class: "#{button_classes(:secondary, size: :compact)} shrink-0 gap-1.5",
                  title: t("game_tables.catalog_pickers.show.customize", name: entry.name), form: { class: "shrink-0" } do %>
      <%= render "shared/icons/pencil" %>
      <span><%= t("game_tables.catalog_pickers.show.customize_short") %></span>
      <span class="sr-only"><%= entry.name %></span>
    <% end %>
  <% end %>
</li>
