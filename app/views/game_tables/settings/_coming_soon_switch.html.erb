<%# A setting announced but not working yet (the functions of the AI, the encumbrance): a line of the list of
    settings, its switch off and disabled, with "Coming soon" beside its name (the neutral badge). The switch has no
    name: nothing is sent. scope and setting: its texts (game_tables.settings.<scope>.<setting>) and its ids %>
<div class="<%= setting_line_classes %>">
  <%= render "game_tables/settings/coming_soon_label", scope: scope, setting: setting %>
  <span class="relative inline-flex shrink-0 opacity-50">
    <%= tag.input type: "checkbox", disabled: true, role: "switch",
                  aria: { labelledby: "#{scope}-#{setting}-label", describedby: "#{scope}-#{setting}-hint" },
                  class: "peer absolute inset-0 z-10 m-0 size-full cursor-not-allowed appearance-none opacity-0" %>
    <span aria-hidden="true" class="<%= switch_track_classes %>"></span>
    <span aria-hidden="true" class="<%= switch_knob_classes %>"></span>
  </span>
</div>
