<%# The way the players get the scores of their abilities: one of those the template offers (their labels, in the
    words of the game), or the player's choice, made on the abilities step of their character (TableRules) %>
<div class="<%= setting_line_classes %>">
  <div class="min-w-0">
    <%= form.label :ability_method_choice, class: "text-sm font-semibold text-ink" %>
    <p id="ability-method-hint" class="mt-1 text-sm text-muted"><%= t("game_tables.settings.edit.ability_method_hint") %></p>
    <%= form.error :ability_method_choice, class: "mt-1 text-sm text-error-ink first-letter:uppercase" %>
  </div>
  <span class="relative block w-full shrink-0 sm:w-64">
    <%= form.select :ability_method_choice, ability_method_options(form.object), {},
                    aria: { describedby: "ability-method-hint" }, class: coming_soon_choice_classes %>
    <%= render "shared/icons/chevron_down", css_class: CollectionSelectInput::CHEVRON_CLASSES %>
  </span>
</div>
