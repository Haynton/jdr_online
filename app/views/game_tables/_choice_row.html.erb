<%# A group of choices of the creation (covers, sheet templates) as a row of cards that scrolls sideways, like the
    row of "My tables": from edge to edge of the content (negative margin, same padding inside), edges that fade
    (row-edge-fade), arrows from 768 px (card_row_controller.js; a finger moves the row on a phone).
    Render it as a layout: the block holds the <li> of the cards. legend: the name of the group; hint: optional.
    filters (optional): pills that filter the cards, like those of "My tables" (table_filter_controller.js, same
    rules); each card then carries its value (cover_card_filter_data), and no_match says when none is left.
    The hint sits right under the legend; the arrows stand apart, at the top right (on the same line, the hint
    lined up with the bottom of the 40 px arrows and left a gap under the legend).
    min-w-0: a fieldset is as wide as its content by default (min-inline-size: min-content), so the row widened
    the whole page instead of scrolling.
    The legend floats (float-left w-full, cleared by what follows): a plain legend sits in the border of the fieldset,
    above its top, so the controls placed at top-0 lined up with the hint and touched the cards %>
<% filters = local_assigns[:filters] %>
<%= tag.fieldset class: "relative mb-8 min-w-0", data: choice_row_data(filterable: filters.present?) do %>
  <legend class="<%= choice_legend_classes %> float-left w-full"><%= legend %></legend>
  <% if local_assigns[:hint] %>
    <p class="<%= choice_row_hint_classes(filterable: filters.present?) %>"><%= hint %></p>
  <% end %>
  <%# The pills and the arrows together, like the row of "My tables": at the top right on a large screen. Below that,
      the pills go under the hint and the arrows (from 768 px) stay at the top right, like in a row without pills %>
  <div class="<%= choice_row_controls_classes(filterable: filters.present?) %>">
    <%# Rendered hidden: shown by the controller, without which they would do nothing %>
    <% if filters.present? %>
      <div hidden role="group" aria-label="<%= t(".filter") %>"
           class="no-scrollbar flex min-w-0 items-center gap-2 overflow-x-auto" data-table-filter-target="pills">
        <% filters.each do |filter| %>
          <button type="button" aria-pressed="false" class="<%= filter_pill_classes %>"
                  data-table-filter-target="pill" data-group="<%= filter[:group] %>" data-value="<%= filter[:value] %>"
                  data-action="table-filter#toggle"><%= filter[:label] %></button>
        <% end %>
      </div>
    <% end %>
    <div class="<%= choice_row_arrows_classes(filterable: filters.present?) %>">
      <button type="button" hidden class="<%= button_classes(:secondary, size: :compact_icon) %>"
              aria-label="<%= t(".previous") %>" data-card-row-target="previousButton" data-action="card-row#scrollPrevious">
        <%= render "shared/icons/chevron_left" %>
      </button>
      <button type="button" hidden class="<%= button_classes(:secondary, size: :compact_icon) %>"
              aria-label="<%= t(".next") %>" data-card-row-target="nextButton" data-action="card-row#scrollNext">
        <%= render "shared/icons/chevron_right" %>
      </button>
    </div>
  </div>
  <ul class="no-scrollbar row-edge-fade clear-left -mx-4 mt-3 flex gap-3 overflow-x-auto px-4 py-1.5 [--row-edge:1.25rem] sm:-mx-8 sm:px-8 sm:[--row-edge:2.5rem] md:mt-5"
      data-card-row-target="row"
      data-action="scroll->card-row#toggleButtons resize@window->card-row#toggleButtons">
    <%= yield %>
    <% if filters.present? %>
      <li hidden class="flex shrink-0 items-center px-1 text-sm text-muted" data-table-filter-target="noMatch">
        <%= local_assigns[:no_match] %>
      </li>
    <% end %>
  </ul>
  <%= local_assigns[:error] %>
<% end %>
