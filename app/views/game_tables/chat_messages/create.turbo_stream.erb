<% unless @refused_message %>
  <%= turbo_stream.append ChatMessage::FEED_TARGET, partial: "game_rooms/chat_line", locals: { line: @chat_message } %>
<% end %>
<%= turbo_stream.replace "game-room-chat-form",
                         partial: "game_rooms/chat_form", locals: { game_table: @game_table, refused_message: @refused_message } %>
