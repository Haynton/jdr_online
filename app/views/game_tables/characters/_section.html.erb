<%# One section of the character sheet: its title over a line, then its fields laid out by their types
    (sheet_section_layout). lead: optional, what opens the section before its fields (the name of the character,
    in the first section); a two-column section puts it at the top of its left column.
    The legend floats, so that it sits in the section and not in the border of the fieldset (see the choice rows) %>
<% layout = sheet_section_layout(fields) %>
<fieldset class="mt-8 min-w-0 border-t border-line pt-6">
  <legend class="float-left mb-4 w-full text-lg font-semibold tracking-tight text-ink"><%= section %></legend>
  <% if local_assigns[:lead] && layout != :two_columns %>
    <div class="clear-left max-w-sm"><%= lead %></div>
  <% end %>
  <%= render "game_tables/characters/section_#{layout}",
             character: character, fields: fields, all_fields: all_fields, computed: computed,
             lead: local_assigns[:lead] %>
</fieldset>
