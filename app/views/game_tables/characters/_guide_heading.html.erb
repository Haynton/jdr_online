<%# A move of a guide in steps on a page (the abilities step: 1 Your scores, 2 Background bonus): its number in a round
    with the tonal look of the steps band (primary-soft, thin ring), then its title. number, id (named by the section
    with aria-labelledby), title %>
<h3 id="<%= id %>" class="flex items-center gap-3 text-base font-semibold text-ink">
  <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary-soft text-xs font-semibold text-primary-soft-ink ring-1 ring-primary-soft-ink/50 ring-inset" aria-hidden="true"><%= number %></span>
  <%= title %>
</h3>
