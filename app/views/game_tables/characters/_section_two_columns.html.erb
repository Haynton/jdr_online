<%# The character part, in two columns (decision): on the left the name and who the character is (class, species,
    alignment, level...), on the right the fields marked column: aside in the template (appearance, personality
    traits, backstory), one under the other. One column under the other below 1024 px, with 24 px between
    them (gap-y-6): without it, a box at the bottom of the left column touched the first label of the right one %>
<% left_fields, aside_fields = fields.partition { |field| !sheet_field_aside?(field) } %>
<div class="clear-left grid gap-x-10 gap-y-6 lg:grid-cols-2">
  <div class="min-w-0">
    <% if lead %>
      <div class="w-full"><%= lead %></div>
    <% end %>
    <%= render "game_tables/characters/section_flow", character: character, fields: left_fields,
                                                     all_fields: all_fields, computed: computed %>
  </div>
  <div class="min-w-0">
    <% aside_fields.each do |field| %>
      <%= render "game_tables/characters/input_field", character: character, field: field, computed: computed %>
    <% end %>
  </div>
</div>
