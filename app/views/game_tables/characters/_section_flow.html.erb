<%# Any other section: each field drawn by its type, with the same look wherever it is (sheet_field_partial), and
    arranged by group (sheet_flow_groups, decision): the lists and short texts in a grid of equal widths (one, two,
    then three per line, by the width of the section), then the boxes and tiles side by side, then the long texts
    across the width, then the switches, each on its line. Mixed on one line, the lists (label above) and the boxes
    (label inside) did not line up. The helps of the boxed fields go under the row (sheet_section_notes) %>
<div class="@container clear-left flex flex-col gap-4">
  <% sheet_flow_groups(fields).each do |group, group_fields| %>
    <%= tag.div class: sheet_flow_group_classes(group) do %>
      <% group_fields.each do |field| %>
        <%= render "game_tables/characters/#{sheet_field_partial(field)}",
                   character: character, field: field, computed: computed, all_fields: all_fields,
                   modifier: computed[:modifiers][field["key"]], value: computed[:values][field["key"]] %>
      <% end %>
    <% end %>
  <% end %>
</div>
<% sheet_section_notes(fields).each do |note| %>
  <p id="<%= note[:id] %>" class="mt-3 max-w-3xl text-xs text-muted">
    <%= t("game_tables.characters.new.note_html", labels: tag.span(note[:labels], class: "font-semibold text-ink"),
                                                  text: note[:text]) %>
  </p>
<% end %>
