<%# Shown while the user has no table: the default cover, and what this page will hold %>
<%= render layout: "game_tables/cover", locals: { cover_image_path: default_cover_image_path, title_id: "empty-tables-title" } do %>
  <h1 id="empty-tables-title" class="text-3xl leading-tight font-bold tracking-tight text-balance text-ink md:text-[40px]">
    <%= t("game_tables.empty_stage.title") %>
  </h1>
  <p class="max-w-md text-[15px] text-ink"><%= t("game_tables.empty_stage.text") %></p>
<% end %>
