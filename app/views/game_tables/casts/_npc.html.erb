<%# One NPC or enemy of the table: its name, what it is and the values the template lists ("Enemy · CR 1/4 · AC 15 ·
    HP 10"), and "Change", which opens its window (the pencil alone on a phone, its word for screen readers). No switch
    "shown to the players" here (decision: nothing shows an NPC to the players yet; the game master will show one from
    the game room, when it is met) %>
<li class="flex min-h-14 items-center justify-between gap-4 border-b border-line py-2.5">
  <div class="min-w-0">
    <p class="truncate text-sm font-semibold text-ink" title="<%= npc.name %>"><%= npc.name %></p>
    <p id="npc-<%= npc.id %>-facts" class="truncate text-xs text-muted"><%= npc_facts(@game_table, npc) %></p>
  </div>
  <%= link_to edit_game_table_npc_path(@game_table, npc), class: "#{button_classes(:secondary, size: :compact)} ml-auto shrink-0",
              title: t("game_tables.casts.edit.change", name: npc.name), data: npc_dialog_link_data do %>
    <%= render "shared/icons/pencil" %>
    <span class="max-sm:sr-only"><%= t("game_tables.catalogs.edit.change_short") %></span>
    <span class="sr-only"><%= npc.name %></span>
  <% end %>
</li>
