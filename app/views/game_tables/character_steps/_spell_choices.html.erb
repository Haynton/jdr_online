<%# The spells to choose (decision: a list filtered in the page, not a window): those of the class of the character
    and of its level (SpellChoices), cantrips then prepared spells by level, each group with its count ("2 sur 3
    choisis", in red past the number allowed). A search by name, without accents nor capitals, hides the other rows
    (spell_choices_controller.js, shown by it: without JavaScript, every row). One row per spell: a check box and its
    name, its school, casting time, range and duration, Concentration and Ritual, then its description folded under
    "Details" (details and summary, open and close without JavaScript). The server copies the spells chosen and
    checks them (CharacterSpellsValidator); a hidden "" lets the player untick every box %>
<% spell_choices = character.spell_choices %>
<% groups = spell_choices.groups %>
<%# Spacing (decision, balanced): 32 px under the header of the page (40 after the sections of the step, when there
    are), the search and the filters 20 px apart (12 px was too tight), one block of tools, then 40 px before each group of spells %>
<%= tag.div class: ["flex flex-col gap-10", ("mt-10" if local_assigns[:after_sections])], data: { controller: "spell-choices" } do %>
  <% if character.errors[:spells].any? %>
    <div role="alert">
      <% character.errors.messages_for(:spells).each do |message| %>
        <p class="<%= SimpleFormFieldClasses::ERROR %>"><%= message %></p>
      <% end %>
    </div>
  <% end %>
  <%= hidden_field_tag "character[spell_keys][]", "", id: nil %>

  <% if groups.empty? %>
    <p class="text-sm text-muted"><%= t("#{SpellChoicesHelper::SCOPE}.none") %></p>
  <% else %>
    <%# The search and the filters (decision: level, school, concentration and ritual, chosen only), shown by the
        controller. Pills of "My tables" (filter_pill_classes): within a group the values add up, between the groups
        they combine, a group with no pill pressed lets every spell through %>
    <div hidden class="flex flex-col gap-5" data-spell-choices-target="tools">
      <div class="w-full max-w-sm">
        <%= label_tag "spell_search", t("#{SpellChoicesHelper::SCOPE}.search"), class: SimpleFormFieldClasses::LABEL %>
        <div class="relative">
          <%= render "shared/icons/search", css_class: "pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted" %>
          <%= search_field_tag "spell_search", nil, class: "#{SimpleFormFieldClasses::INPUT} pl-9", autocomplete: "off",
                                                    data: { spell_choices_target: "search", action: "input->spell-choices#filter" } %>
        </div>
      </div>
      <%# On a phone, one line that scrolls sideways (as the pills of "My tables"): wrapped, a separator started a line %>
      <div class="no-scrollbar -mx-4 flex items-center gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0">
        <% spell_filter_groups(groups).each_with_index do |(group, pills), position| %>
          <% if position.positive? %>
            <span class="mx-1 h-5 w-px shrink-0 bg-line" aria-hidden="true"></span>
          <% end %>
          <div class="flex shrink-0 gap-2 sm:flex-wrap" role="group" aria-label="<%= spell_filter_label(group) %>">
            <% pills.each do |value, label| %>
              <button type="button" aria-pressed="false" class="<%= filter_pill_classes %>"
                      data-spell-choices-target="pill" data-group="<%= group %>" data-value="<%= value %>"
                      data-action="spell-choices#toggle"><%= label %></button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <p hidden class="text-sm text-muted" role="status" data-spell-choices-target="noMatch">
      <%= t("#{SpellChoicesHelper::SCOPE}.no_match") %>
    </p>

    <% groups.each do |group| %>
      <%= tag.fieldset class: "min-w-0", data: spell_group_data(group) do %>
        <%# The legend floats (as in game_tables/_choice_row): a legend in place sits in the border of the fieldset, and
            the count beside it would not line up %>
        <legend class="float-left mr-6 text-lg leading-7 font-bold text-ink"><%= t("#{SpellChoicesHelper::SCOPE}.title_#{group.kind}") %></legend>
        <%= tag.p spell_group_status(character, group), role: "status",
                  class: "text-sm leading-7 font-medium text-ink data-invalid:text-error-ink",
                  data: { spell_choices_target: "status", invalid: ("" if spell_group_over?(character, group)) } %>
        <p class="clear-left mt-1 text-sm text-muted"><%= spell_group_hint(group, spell_choices) %></p>
        <%# One block per level, hidden by the search when none of its spells is left %>
        <% spells_by_level(group).each do |level, spells| %>
          <div data-spell-choices-target="block">
            <% if group.kind == :prepared %>
              <h3 class="mt-5 text-[11px] font-semibold tracking-wider text-muted uppercase"><%= t("#{SpellChoicesHelper::SCOPE}.level", level: level) %></h3>
            <% end %>
            <%# Each card at its own height (items-start): an open description does not stretch the cards beside it %>
            <ul class="mt-3 grid items-start gap-3 md:grid-cols-2 xl:grid-cols-3">
              <% spells.each do |spell| %>
                <%= render "game_tables/character_steps/spell_choice", character: character, spell: spell %>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
