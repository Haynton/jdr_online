<%# One spell to choose: its box and name (on one line, cut with its whole name as a tooltip: every card keeps the same
    height), what it costs to cast, then "Details" under the box, aligned with it, and Concentration and Ritual on the
    right of that line (decision: on the line of the name, a long name pushed them onto a second line). "Details" opens
    the window of the step (shared/_details_dialog) with the details of the spell (decision: a window rather than a fold, which made the card
    grow; details_dialog_controller.js copies them into it). The button is rendered hidden and shown by the controller,
    which hides the fold instead: without JavaScript, the details still open under the card. Never inside the label: a
    click on "Details" must not tick the box. data-level, -school and -casting are read by the filters
    (spell_choices_controller.js). A spell always prepared (always_prepared) has its box ticked and disabled: it is
    never sent, the server copies it %>
<% box_id = spell_box_id(spell) %>
<%= tag.li class: CharacterSheets::SpellChoicesHelper::SPELL_ROW_CLASSES, data: spell_card_data(spell) do %>
  <div class="flex items-start gap-2.5">
    <% if local_assigns[:always_prepared] %>
      <%= check_box_tag nil, spell.key, true, id: box_id, disabled: true, class: "#{SimpleFormFieldClasses::CHECKBOX} mt-px",
                                               aria: { describedby: "#{box_id}_summary" } %>
    <% else %>
      <%= check_box_tag "character[spell_keys][]", spell.key, spell_chosen?(character, spell), id: box_id,
                        class: "#{SimpleFormFieldClasses::CHECKBOX} mt-px",
                        aria: { describedby: "#{box_id}_summary" } %>
    <% end %>
    <div class="min-w-0 flex-1">
      <%= label_tag box_id, spell.name, class: "block truncate text-[15px] leading-5 font-semibold text-ink",
                                        title: spell.name %>
      <p id="<%= box_id %>_summary" class="mt-0.5 truncate text-xs text-muted"><%= spell_summary_line(spell) %></p>
    </div>
  </div>
  <div class="relative mt-2">
    <button type="button" hidden aria-haspopup="dialog"
            class="flex h-5 w-fit cursor-pointer items-center gap-1 rounded text-xs font-medium text-link hover:underline"
            data-details-dialog-target="opener" data-action="details-dialog#open"
            data-details-dialog-name-param="<%= spell.name %>" data-details-dialog-summary-param="<%= spell_summary_line(spell) %>">
      <%= render "shared/icons/info", css_class: "size-3.5" %>
      <%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.details") %>
      <span class="sr-only"><%= spell.name %></span>
    </button>
    <details class="group" data-details-dialog-target="fold">
      <summary class="flex h-5 w-fit cursor-pointer list-none items-center gap-1 rounded text-xs font-medium text-link hover:underline [&::-webkit-details-marker]:hidden">
        <%= render "shared/icons/chevron_right", css_class: "size-3.5 transition-transform group-open:rotate-90 motion-reduce:transition-none" %>
        <%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.details") %>
      </summary>
      <div class="mt-2">
        <div data-details-dialog-content><%= render "game_tables/character_steps/spell_details", spell: spell %></div>
      </div>
    </details>
    <% if (tags = spell_tags(spell)).any? %>
      <p class="absolute top-0 right-0 flex gap-1.5">
        <% tags.each do |tag_text| %>
          <span class="<%= CharacterSheets::SpellChoicesHelper::SPELL_TAG_CLASSES %>"><%= tag_text %></span>
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
