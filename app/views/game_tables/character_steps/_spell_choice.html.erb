<%# One spell to choose: its box and name (on one line, cut with its whole name as a tooltip: every card keeps the same
    height), what it costs to cast, then "Details" under the box, aligned with it, and Concentration and Ritual on the
    right of that line (decision: on the line of the name, a long name pushed them onto a second line). The details
    sit beside the label, never inside it: a click on "Details" must not tick the box. data-level, -school and
    -casting are read by the filters (spell_choices_controller.js) %>
<% box_id = spell_box_id(spell) %>
<%= tag.li class: CharacterSheets::SpellChoicesHelper::SPELL_ROW_CLASSES, data: spell_card_data(spell) do %>
  <div class="flex items-start gap-2.5">
    <%= check_box_tag "character[spell_keys][]", spell.key, spell_chosen?(character, spell), id: box_id,
                      class: "#{SimpleFormFieldClasses::CHECKBOX} mt-px",
                      aria: { describedby: "#{box_id}_summary" } %>
    <div class="min-w-0 flex-1">
      <%= label_tag box_id, spell.name, class: "block truncate text-[15px] leading-5 font-semibold text-ink",
                                        title: spell.name %>
      <p id="<%= box_id %>_summary" class="mt-0.5 truncate text-xs text-muted"><%= spell_summary_line(spell) %></p>
    </div>
  </div>
  <div class="relative mt-2">
    <details class="group">
      <summary class="flex h-5 w-fit cursor-pointer list-none items-center gap-1 rounded text-xs font-medium text-link hover:underline [&::-webkit-details-marker]:hidden">
        <%= render "shared/icons/chevron_right", css_class: "size-3.5 transition-transform group-open:rotate-90 motion-reduce:transition-none" %>
        <%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.details") %>
      </summary>
      <div class="mt-2 flex flex-col gap-2 text-sm text-ink">
        <% if (trigger = spell_casting_trigger(spell)) %>
          <p class="text-xs text-muted"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.casting_time", text: trigger) %></p>
        <% end %>
        <p class="text-xs text-muted"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.components", list: spell_components(spell)) %></p>
        <%= simple_format(spell.description, { class: "leading-relaxed" }, wrapper_tag: "p") %>
        <% if spell.properties["higher_levels"] %>
          <p class="leading-relaxed">
            <span class="font-semibold"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.higher_levels") %></span>
            <%= spell.properties["higher_levels"] %>
          </p>
        <% end %>
      </div>
    </details>
    <% if (tags = spell_tags(spell)).any? %>
      <p class="absolute top-0 right-0 flex gap-1.5">
        <% tags.each do |tag_text| %>
          <span class="<%= CharacterSheets::SpellChoicesHelper::SPELL_TAG_CLASSES %>"><%= tag_text %></span>
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
