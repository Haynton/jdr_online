<%# The spells to choose in the window of the game room (decision: a list filtered in the page, not a window): those of the class of the character
    and of its level (CharacterSheets::SpellChoices), cantrips then prepared spells by level, each group with its count ("2 sur 3
    choisis", in red past the number allowed). A search by name, without accents nor capitals, hides the other rows
    (spell_choices_controller.js, shown by it: without JavaScript, every row). One row per spell: a check box and its
    name, its school, casting time, range and duration, Concentration and Ritual, then "Details", which opens its
    description in the window of the step (shared/_details_dialog; folded under the card
    without JavaScript). The server copies the spells chosen and
    checks them (CharacterSpellsValidator); a hidden "" lets the player untick every box %>
<% spell_choices = character.spell_choices %>
<% groups = spell_choices.groups %>
<%# Spacing (decision, balanced): 32 px under the header of the page (40 after the sections of the step, when there
    are), the search and the filters 20 px apart (12 px was too tight), one block of tools, then 40 px before each group of spells %>
<%# compact: the window of the game room (game_tables/spell_choices/edit): no spell slots (the panel « Sorts » shows
    them behind the window), the search and the filters on one line where they fit, its label in the field, 24 px
    between the blocks (Anthony's request: tighter) %>
<% compact = local_assigns[:compact] %>
<%= tag.div class: ["flex flex-col", compact ? "gap-6" : "gap-10", ("mt-10" if local_assigns[:after_sections])], data: { controller: "spell-choices details-dialog" } do %>
  <% if character.errors[:spells].any? %>
    <div role="alert">
      <% character.errors.messages_for(:spells).each do |message| %>
        <p class="<%= SimpleFormFieldClasses::ERROR %>"><%= message %></p>
      <% end %>
    </div>
  <% end %>
  <%= hidden_field_tag "character[spell_keys][]", "", id: nil %>
  <%# The spellbook of a wizard: its spells ticked on the cards of the group it prepares from, each with « Préparé »
      once written in it (CharacterSheets::Spellbook) %>
  <% book = character.spellbook_of_class %>
  <% if book.any? && !compact %>
    <%= hidden_field_tag "character[spellbook_keys][]", "", id: nil %>
  <% end %>
  <%= render "shared/details_dialog", id: local_assigns.fetch(:details_dialog_id, "details-dialog") %>
  <%# The spell slots first (decision): they say how far the prepared spells will go %>
  <% if !compact && (slots = character_spell_slots(character)) %>
    <%= render "character_sheets/summary/spell_slots", slots: slots, title_classes: "text-lg leading-7 font-bold text-ink" %>
  <% end %>

  <% if groups.empty? %>
    <p class="text-sm text-muted"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.none") %></p>
  <% else %>
    <%# The search and the filters (decision: level, school, concentration and ritual, chosen only), shown by the
        controller. Pills of "My tables" (filter_pill_classes): within a group the values add up, between the groups
        they combine, a group with no pill pressed lets every spell through %>
    <div hidden class="<%= compact ? "flex flex-col gap-3 lg:flex-row lg:items-start lg:gap-4" : "flex flex-col gap-5" %>" data-spell-choices-target="tools">
      <div class="<%= compact ? "w-full shrink-0 lg:w-64" : "w-full max-w-sm" %>">
        <%= label_tag "spell_search", t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.search"),
                      class: compact ? "sr-only" : SimpleFormFieldClasses::LABEL %>
        <div class="relative">
          <%= render "shared/icons/search", css_class: "pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted" %>
          <%= search_field_tag "spell_search", nil, class: "#{SimpleFormFieldClasses::INPUT} pl-9", autocomplete: "off",
                                                    placeholder: (t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.search") if compact),
                                                    data: { spell_choices_target: "search", action: "input->spell-choices#filter" } %>
        </div>
      </div>
      <%# The groups set apart by a line (decision), where the pills hold on one line: on a phone (one line that scrolls
          sideways, as the pills of "My tables") and from 1280 px. Between the two, the groups and their pills wrap:
          a line would start or end a row, so a wider gap sets them apart (24 px across, 12 px down; 8 px within) %>
      <div class="no-scrollbar -mx-4 flex gap-x-3 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:gap-x-6 sm:gap-y-3 sm:overflow-visible sm:px-0 xl:gap-x-3">
        <% spell_filter_groups(groups).each_with_index do |(group, pills), position| %>
          <% if position.positive? %>
            <span class="h-5 w-px shrink-0 self-center bg-line sm:hidden xl:block" aria-hidden="true"></span>
          <% end %>
          <div class="flex shrink-0 gap-2 sm:min-w-0 sm:shrink sm:flex-wrap" role="group" aria-label="<%= spell_filter_label(group) %>">
            <% pills.each do |value, label| %>
              <button type="button" aria-pressed="false" class="<%= filter_pill_classes %>"
                      data-spell-choices-target="pill" data-group="<%= group %>" data-value="<%= value %>"
                      data-action="spell-choices#toggle"><%= label %></button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <p hidden class="text-sm text-muted" role="status" data-spell-choices-target="noMatch">
      <%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.no_match") %>
    </p>

    <%# The spells always prepared (the domain spells of the subclass), ticked and disabled, as the languages always
        known: chosen by the server, counted in no group %>
    <% always_prepared = spell_choices.always_prepared %>
    <% if always_prepared.any? %>
      <section class="min-w-0" data-spell-choices-target="block" aria-labelledby="always_prepared_spells">
        <h2 id="always_prepared_spells" class="text-lg leading-7 font-bold text-ink"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.always_prepared") %></h2>
        <p class="mt-1 text-sm text-muted"><%= always_prepared_spells_hint(always_prepared) %></p>
        <ul class="mt-3 grid grid-cols-1 items-start gap-3 md:grid-cols-2 xl:grid-cols-3">
          <% always_prepared.entries.each do |spell| %>
            <%= render "game_tables/character_steps/spell_choice", character: character, spell: spell, always_prepared: true %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# The spells a feat gives already (Magic Initiate), ticked and disabled with where they come from %>
    <% known_by_feats = character.feat_spells.known_elsewhere(except: CharacterSheets::FeatSpells::CLASS_SOURCE) %>
    <% groups.each do |group| %>
      <% in_book = book.any? && book.group.key == group.key %>
      <%# In the game room, the book does not change here (a spell is copied into it): only its spells, to prepare %>
      <% group = group.with(spells: group.spells.select { |spell| book.include?(spell.key) }) if in_book && compact %>
      <%= tag.fieldset class: "min-w-0", data: spell_group_data(group) do %>
        <%# The legend floats (as in game_tables/_choice_row): a legend in place sits in the border of the fieldset, and
            the count beside it would not line up %>
        <legend class="float-left mr-6 text-lg leading-7 font-bold text-ink"><%= group.label %></legend>
        <%= tag.p spell_group_status(character, group), role: "status",
                  class: "text-sm leading-7 font-medium text-ink data-invalid:text-error-ink",
                  data: { spell_choices_target: "status", invalid: ("" if spell_group_over?(character, group)),
                          count_for: ("prepared" if in_book) } %>
        <p class="clear-left mt-1 text-sm text-muted"><%= spell_group_hint(group) %></p>
        <% if in_book && !compact %>
          <%= tag.p spellbook_status(book), role: "status",
                    class: "mt-3 text-sm font-medium text-ink data-invalid:text-error-ink",
                    data: spellbook_status_data(book) %>
          <p class="mt-1 text-sm text-muted"><%= book.help %></p>
        <% end %>
        <%# One block per level, hidden by the search when none of its spells is left %>
        <% spells_by_level(group).each do |level, spells| %>
          <div data-spell-choices-target="block">
            <%# A group of several levels (the prepared spells) titles each of them %>
            <% if group.several_levels %>
              <h3 class="mt-5 text-[11px] font-semibold tracking-wider text-muted uppercase"><%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.level", level: level) %></h3>
            <% end %>
            <%# Each card at its own height (items-start): an open description does not stretch the cards beside it %>
            <ul class="mt-3 grid grid-cols-1 items-start gap-3 md:grid-cols-2 xl:grid-cols-3">
              <% spells.each do |spell| %>
                <%= render "game_tables/character_steps/spell_choice", character: character, spell: spell,
                                                                       known_as: known_by_feats[spell.key],
                                                                       book: (book if in_book), book_locked: compact %>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
