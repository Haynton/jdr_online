<%# The window of the details of a spell, one for the whole step: empty until "Details" is clicked on a card, then
    spell_details_controller.js writes the name and the line of the spell in its title bar and copies its details
    (rendered in the card, folded) under it. Centered, 640 px wide at most, as tall as its text up to the screen: only
    the text scrolls. Escape, the cross or a click beside it close it, and the focus goes back to "Details" %>
<dialog id="spell-details-dialog" aria-labelledby="spell-details-dialog-title" tabindex="-1"
        class="m-auto max-h-[min(760px,calc(100dvh-2rem))] w-[min(640px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl outline-none backdrop:bg-black/50 open:flex"
        data-spell-details-target="dialog"
        data-action="click->spell-details#closeOnBackdrop close->spell-details#returnFocus turbo:before-cache@document->spell-details#close">
  <header class="flex shrink-0 items-start justify-between gap-4 border-b border-line py-4 pr-3 pl-6">
    <div class="min-w-0">
      <h2 id="spell-details-dialog-title" class="text-lg font-semibold text-ink" data-spell-details-target="title"></h2>
      <p class="text-sm text-muted" data-spell-details-target="summary"></p>
    </div>
    <button type="button" class="<%= button_classes(:quiet, size: :compact_icon) %>"
            aria-label="<%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.close_details") %>"
            title="<%= t("#{CharacterSheets::SpellChoicesHelper::SCOPE}.close_details") %>"
            data-action="spell-details#close">
      <%= render "shared/icons/x", css_class: "size-5" %>
    </button>
  </header>
  <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5 text-[15px]" data-spell-details-target="body"></div>
</dialog>
