<%# The origin feat the species lets pick (decision of 27 November: the human), each a card with its summary, a feat that
    gives spells one card per list (CharacterSheets::FeatCards), then what the one picked asks, prepared for each and
    shown as soon as it is picked (choice_blocks_controller.js): the skills of Skilled, the spells of Magic Initiate %>
<% entry = character.species_feat_entry %>
<% cards = CharacterSheets::FeatCards.new(character, source: CharacterFeats::SPECIES_SOURCE).cards(character.species_feat_offers) %>
<% picked_value = CharacterSheets::FeatCards.value_of(entry["key"], entry["spell_list"]) %>
<% known_skills = character.skill_choices.granted_keys - Array(entry["skills"]) %>
<% skill_fields = character.sheet_fields.select do |field|
     character.skill_choices.skill_keys.include?(field["key"]) && known_skills.exclude?(field["key"])
   end %>
<%# On its own step (CreationStepBehaviors::ChoosesSpeciesFeat): the title and the introduction of the step say what
    it is, the section only says where the feat comes from %>
<section class="mx-auto flex w-full max-w-6xl min-w-0 flex-col gap-6" data-controller="choice-blocks">
  <%= render "game_tables/character_steps/feat_errors", character: character %>
  <h2 class="text-xs font-semibold text-brass">
    <span class="sr-only"><%= t("game_tables.character_steps.species_feat.title") %> ·</span>
    <%= t("game_tables.character_steps.feat_spells.chosen_through_species", option: character.feat_origin("source" => CharacterFeats::SPECIES_SOURCE)) %>
  </h2>
  <%# Every card of the same height, whatever its row (auto-rows-fr): the rows of the feats with a list were taller %>
  <div class="grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% cards.each do |card| %>
      <%= render "game_tables/character_steps/feat_card", card: card, field_name: "character[species_feat][key]",
                                                          checked: picked_value == card.value, id_prefix: "species-feat" %>
    <% end %>
  </div>
  <% cards.reject(&:taken?).each do |card| %>
    <% skills = card.feat.effects.dig("skill_picks", "count").to_i %>
    <% spells = card.feat.effects["spell_picks"] %>
    <% next unless skills.positive? || card.list %>
    <% picked = picked_value == card.value ? entry : {} %>
    <%= tag.div class: "flex flex-col gap-6", hidden: picked_value != card.value, data: { choice_blocks_target: "block", choice_value: card.value } do %>
      <% if skills.positive? %>
        <%# As many skills as the feat gives: a count, the others faded once enough are ticked (pick_limit_controller.js) %>
        <%= tag.fieldset class: "min-w-0",
                         data: { controller: "pick-limit", action: "change->pick-limit#count", pick_limit_allowed_value: skills,
                                 pick_limit_template_value: t("game_tables.character_steps.feat_spells.chosen", count: skills,
                                                                                                                chosen: "__CHOSEN__") } do %>
          <legend class="<%= CharacterSheets::WeaponMasteryChoicesHelper::TITLE_CLASSES %>"><%= t("game_tables.level_ups.feat.skills", count: skills) %></legend>
          <p class="clear-left pt-1 text-sm font-semibold text-brass data-invalid:text-error-ink" role="status" data-pick-limit-target="count">
            <%= t("game_tables.character_steps.feat_spells.chosen", count: skills, chosen: Array(picked["skills"]).size) %>
          </p>
          <%= hidden_field_tag "character[species_feat][skills][]", "", id: nil %>
          <div class="clear-left flex flex-wrap gap-1.5 pt-3">
            <% skill_fields.each do |field| %>
              <label class="<%= CharacterSheets::WeaponMasteryChoicesHelper::CHIP_CLASSES %>">
                <%= check_box_tag "character[species_feat][skills][]", field["key"], Array(picked["skills"]).include?(field["key"]),
                                  id: "species-feat-skill-#{field["key"]}", class: "peer sr-only",
                                  data: { pick_limit_target: "box" } %>
                <span class="size-2.5 shrink-0 rotate-45 rounded-[2px] border border-brass group-has-checked/pick:bg-brass" aria-hidden="true"></span>
                <%= field["label"] %>
              </label>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if card.list %>
        <p class="text-sm text-muted">
          <%= t("game_tables.character_steps.feat_spells.list_hint", count: spells["cantrips"].to_i + spells["level_one"].to_i) %>
        </p>
        <%= render "game_tables/character_steps/feat_spell_picks", character: character, with_spells: false, list: card.list, settings: spells,
                                                                   field_name: "character[species_feat][feat_spells][by_list][#{card.list}]",
                                                                   picks: picked,
                                                                   known: character.feat_spells.known_elsewhere(except: CharacterFeats::SPECIES_SOURCE) %>
      <% end %>
    <% end %>
  <% end %>
</section>
