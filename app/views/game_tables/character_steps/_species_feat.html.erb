<%# The origin feat the species lets pick (decision of 27 November: the human), each a card with its summary, a feat that
    gives spells one card per list (CharacterSheets::FeatCards), then what the one picked asks, prepared for each and
    shown as soon as it is picked (choice_blocks_controller.js): the skills of Skilled, the spells of Magic Initiate %>
<% entry = character.species_feat_entry %>
<% cards = CharacterSheets::FeatCards.new(character, source: CharacterFeats::SPECIES_SOURCE).cards(character.species_feat_offers) %>
<% picked_value = CharacterSheets::FeatCards.value_of(entry["key"], entry["spell_list"]) %>
<% known_skills = character.skill_choices.granted_keys - Array(entry["skills"]) %>
<% skill_fields = character.sheet_fields.select do |field|
     character.skill_choices.skill_keys.include?(field["key"]) && known_skills.exclude?(field["key"])
   end %>
<section class="flex min-w-0 flex-col gap-6" data-controller="choice-blocks">
  <div>
    <h2 class="text-lg leading-7 font-bold text-ink"><%= t("game_tables.character_steps.species_feat.title") %></h2>
    <p class="pt-1 text-sm text-brass">
      <%= t("game_tables.character_steps.feat_spells.chosen_through_species", option: character.feat_origin("source" => CharacterFeats::SPECIES_SOURCE)) %>
    </p>
    <p class="pt-1 text-sm text-muted"><%= t("game_tables.character_steps.species_feat.hint") %></p>
  </div>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% cards.each do |card| %>
      <%= render "game_tables/character_steps/feat_card", card: card, field_name: "character[species_feat][key]",
                                                          checked: picked_value == card.value, id_prefix: "species-feat" %>
    <% end %>
  </div>
  <% cards.reject(&:taken?).each do |card| %>
    <% skills = card.feat.effects.dig("skill_picks", "count").to_i %>
    <% spells = card.feat.effects["spell_picks"] %>
    <% next unless skills.positive? || card.list %>
    <% picked = picked_value == card.value ? entry : {} %>
    <%= tag.div class: "flex flex-col gap-6", hidden: picked_value != card.value, data: { choice_blocks_target: "block", choice_value: card.value } do %>
      <% if skills.positive? %>
        <fieldset class="min-w-0">
          <legend class="text-sm font-semibold text-ink"><%= t("game_tables.level_ups.feat.skills", count: skills) %></legend>
          <%= hidden_field_tag "character[species_feat][skills][]", "", id: nil %>
          <ul class="mt-2 grid gap-x-6 gap-y-2 sm:grid-cols-2 xl:grid-cols-3">
            <% skill_fields.each do |field| %>
              <li>
                <label class="flex items-center gap-2 text-sm text-ink">
                  <%= check_box_tag "character[species_feat][skills][]", field["key"], Array(picked["skills"]).include?(field["key"]),
                                    id: "species-feat-skill-#{field["key"]}", class: SimpleFormFieldClasses::CHECKBOX %>
                  <%= field["label"] %>
                </label>
              </li>
            <% end %>
          </ul>
        </fieldset>
      <% end %>
      <% if card.list %>
        <p class="text-sm text-muted">
          <%= t("game_tables.character_steps.feat_spells.list_hint", count: spells["cantrips"].to_i + spells["level_one"].to_i) %>
        </p>
        <%= render "game_tables/character_steps/feat_spell_picks", character: character, list: card.list, settings: spells,
                                                                   field_name: "character[species_feat][feat_spells][by_list][#{card.list}]",
                                                                   picks: picked,
                                                                   known: character.feat_spells.known_elsewhere(except: CharacterFeats::SPECIES_SOURCE) %>
      <% end %>
    <% end %>
  <% end %>
</section>
