<%# The step « Dons » (decision of 27 November, its own step after the skills): the origin feat the background gives,
    shown even with nothing to pick (Alert for the criminal), with the spells of Magic Initiate in the list it fixes
    (sent as character[feat_spells]); then the origin feat the species lets pick (the human, sent as
    character[species_feat], game_tables/character_steps/_species_feat); then the feats of the levels it starts above
    (CreationFeat, sent as character[level_feats][<level>], the window of a level gained drawing them). Kept by CreationStepBehaviors::ChoosesOriginFeats,
    checked by CharacterFeatSpellsValidator, its errors floating above the page (_feat_errors) %>
<% feat = character.background_feat %>
<% given = character.origin_feat_spells %>
<div class="mx-auto flex w-full max-w-6xl min-w-0 flex-col gap-12">
  <%= render "game_tables/character_steps/feat_errors", character: character %>
  <% if feat %>
    <section class="flex min-w-0 flex-col gap-4">
      <%# The feat itself on one line: its name, then what gives it; its summary under it (no box, decision) %>
      <div>
        <h2 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-lg font-bold tracking-tight text-ink">
            <%= given ? t("game_tables.character_steps.feat_cards.with_list", feat: feat.name, list: given[:settings]["lists"].first) : feat.name %>
          </span>
          <span class="text-xs font-semibold text-brass">
            <%= t("game_tables.character_steps.origin_feats.background_title") %> ·
            <%= t("game_tables.character_steps.feat_spells.given_by_background", option: character.feat_origin("source" => CharacterFeats::BACKGROUND_SOURCE)) %>
          </span>
        </h2>
        <p class="max-w-4xl pt-1 text-sm text-muted">
          <%= feat.description %>
          <% if given %>
            <%= t("game_tables.character_steps.feat_spells.background_hint", list: given[:settings]["lists"].first,
                                                                              count: given[:settings]["cantrips"].to_i + given[:settings]["level_one"].to_i) %>
          <% end %>
        </p>
      </div>
      <% if given %>
        <%= render "game_tables/character_steps/feat_spell_picks", character: character, with_spells: false, list: given[:settings]["lists"].first,
                                                                   settings: given[:settings], field_name: "character[feat_spells]",
                                                                   picks: character.origin_feat_picks,
                                                                   known: character.feat_spells.known_elsewhere(except: CharacterFeats::BACKGROUND_SOURCE) %>
      <% else %>
        <p class="text-sm text-muted"><%= t("game_tables.character_steps.origin_feats.nothing_to_pick") %></p>
      <% end %>
    </section>
  <% end %>
  <% level_feats = character.creation_feats %>
  <% if level_feats.any? %>
    <% level_feats.each(&:validate) if character.errors[:feats].any? %>
    <section class="flex min-w-0 flex-col gap-10">
      <p class="text-sm text-brass"><%= t("game_tables.character_steps.origin_feats.level_hint", level: character.current_level) %></p>
      <% level_feats.each do |level_feat| %>
        <div class="max-w-3xl">
          <%= render "game_tables/level_ups/feat", level_up: level_feat,
                                                   title: t("game_tables.character_steps.origin_feats.level_title", level: level_feat.level) %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
