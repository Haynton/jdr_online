<%# The origin feats of the creation (decision of 27 November), at the step of the skills: the spells the origin feat
    of the background gives (Magic Initiate of the acolyte and the sage), in the list the background fixes, sent as
    character[feat_spells]; then the origin feat the species lets pick (the human), sent as character[species_feat]
    (game_tables/character_steps/_species_feat). Kept by CreationStepBehaviors::ChoosesOriginFeats, checked by
    CharacterFeatSpellsValidator (its errors above the choices) %>
<% given = character.origin_feat_spells %>
<% if given %>
  <section class="<%= local_assigns[:after_sections] ? "mt-10" : "mt-2" %> min-w-0">
    <h2 class="text-lg leading-7 font-bold text-ink"><%= given[:feat].name %></h2>
    <p class="pt-1 text-sm text-brass">
      <%= t("game_tables.character_steps.feat_spells.given_by_background", option: character.feat_origin("source" => CharacterFeats::BACKGROUND_SOURCE)) %>
    </p>
    <p class="pt-1 text-sm text-muted">
      <%= t("game_tables.character_steps.feat_spells.background_hint", list: given[:settings]["lists"].first,
                                                                        count: given[:settings]["cantrips"].to_i + given[:settings]["level_one"].to_i) %>
    </p>
    <% character.errors.full_messages_for(:feats).each do |message| %>
      <p class="<%= SimpleFormFieldClasses::ERROR %>"><%= message %></p>
    <% end %>
    <div class="mt-4">
      <%= render "game_tables/character_steps/feat_spell_picks", character: character, list: given[:settings]["lists"].first,
                                                                 settings: given[:settings], field_name: "character[feat_spells]",
                                                                 picks: character.origin_feat_picks,
                                                                 known: character.feat_spells.known_elsewhere(except: CharacterFeats::BACKGROUND_SOURCE) %>
    </div>
  </section>
<% end %>
<%= render "game_tables/character_steps/species_feat", character: character if character.feat_choice_settings %>
