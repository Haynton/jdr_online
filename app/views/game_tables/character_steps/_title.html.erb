<%# The title of a step of the creation, centered between two small diamonds (no lines around it, decision), and the
    sentence that says what the step is for, 40 px above the content (24 on a short screen, 820 px high or less). lede: optional %>
<div class="mb-10 text-center [@media(max-height:820px)]:mb-6">
  <h1 class="flex items-center justify-center gap-3 text-2xl font-extrabold">
    <span class="size-1.5 rotate-45 bg-brass" aria-hidden="true"></span>
    <%= title %>
    <span class="size-1.5 rotate-45 bg-brass" aria-hidden="true"></span>
  </h1>
  <% if local_assigns[:lede].present? %>
    <p class="mx-auto mt-2 max-w-2xl text-muted"><%= lede %></p>
  <% end %>
</div>
