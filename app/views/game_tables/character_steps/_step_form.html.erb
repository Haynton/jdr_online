<%# The form of one step: its sections (game_tables/characters/_section), the name first when the step asks it,
    then Back, Later and Continue at the end, on the right. Continue saves the draft and opens the next step; Back,
    Later and the steps of the band save it too, then go where they point (go_to: the hidden field below, filled by
    save_before_leaving_controller.js for the band, or the value of the button).
    The form fills the rest of the page (flex-1): its buttons go to the bottom of the screen on a short step %>
<%= simple_form_for character, url: game_table_character_step_path(character.game_table, step.key), method: :patch,
                               html: { class: "flex flex-1 flex-col" },
                               data: character_sheet_form_data(character, computed) do |f| %>
  <%= hidden_field_tag :go_to, "", id: nil, data: { save_before_leaving_target: "destination" } %>
  <%= form_error_notification(f) %>
  <%# Asked by the step that names the character; required to finish, not for the draft %>
  <% if step.asks_name %>
    <% name_input = capture { f.input :name, required: true, autofocus: true, input_html: { autocomplete: "off" } } %>
  <% end %>
  <% sections = sheet_sections(step_page_fields(step)) %>
  <% if sections.empty? && name_input %>
    <div class="max-w-sm"><%= name_input %></div>
  <% end %>

  <% sections.each_with_index do |(section, fields), position| %>
    <%= render "game_tables/characters/section", section: section, fields: fields, character: character,
                                                all_fields: character.sheet_fields, computed: computed,
                                                lead: (name_input if position.zero?),
                                                page_title: character_step_label(step) %>
  <% end %>

  <% if step.chooses_equipment %>
    <%= render "game_tables/character_steps/equipment_choices", character: character %>
  <% elsif step.chooses_spells %>
    <%= render "game_tables/character_steps/spell_choices", character: character, after_sections: sections.any? %>
  <% end %>

  <%= render layout: "game_tables/character_steps/actions", locals: { character: character, step: step, saves: true } do %>
    <%= f.button :submit, t("game_tables.character_steps.show.continue"), class: button_classes(:primary) %>
  <% end %>
<% end %>
