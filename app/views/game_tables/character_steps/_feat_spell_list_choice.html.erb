<%# The list a feat that gives spells takes (Magic Initiate, picked through the species or at a level gained): the
    question, the rule (its spells come from one list, set for good, one changed at each level gained), the lists its
    other feats took already, then a card for each list left with its description (written by the template:
    list_descriptions). Each list shows its spells as soon as it is picked (choice_blocks_controller.js around it).
    settings: those of the feat, the lists taken left out (CharacterSheets::FeatSpells#open_settings) %>
<% raw_lists = Array(local_assigns[:all_lists]) %>
<% taken = raw_lists - Array(settings["lists"]) %>
<% count = settings["cantrips"].to_i + settings["level_one"].to_i %>
<fieldset class="min-w-0" <%= tag.attributes(aria: { describedby: local_assigns[:error_id] }) %>>
  <legend class="text-sm font-semibold text-ink"><%= t("game_tables.character_steps.feat_spells.list_question") %></legend>
  <p class="mt-1 text-sm text-muted"><%= t("game_tables.character_steps.feat_spells.list_hint", count: count) %></p>
  <% if taken.any? %>
    <p class="mt-1 text-sm text-muted">
      <%= t("game_tables.character_steps.feat_spells.lists_taken", lists: taken.to_sentence) %>
    </p>
  <% end %>
  <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
    <% Array(settings["lists"]).each do |list| %>
      <label class="<%= weapon_mastery_card_classes %>">
        <%= radio_button_tag field_name, list, picked == list, id: nil, class: "mt-1 shrink-0 accent-current",
                             data: { choice_blocks_target: "choice", action: "choice-blocks#show" } %>
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-ink"><%= list %></span>
          <% if (description = settings.dig("list_descriptions", list)) %>
            <span class="mt-0.5 block text-xs text-muted"><%= description %></span>
          <% end %>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
