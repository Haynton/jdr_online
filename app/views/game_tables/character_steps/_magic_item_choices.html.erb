<%# What a character created above level 1 gets more (decision of 27 November, CharacterHigherLevelEquipment): the gold
    of its level (its rolled part rolled by the server when the character is done), then one list per magic item its
    level gives, by rarity: a magic item of the table, or a magic put on an item of its equipment (« Épée longue +1 »),
    sent as character[starting_magic_items][<place>]. Nothing at level 1, or with the normal equipment only.
    Drawn as the lines of the equipment above it (decision of 28 November: a grid of grey fields broke the page): its
    title in small capitals and its gold beside it, one line per place, its pick in gold on the right, two columns from
    1024 px, in the same centered column. A place left empty after Continue is written in red, said once above %>
<% tier = character.higher_level_equipment_tier %>
<% if tier %>
  <% places = character.magic_item_places %>
  <% picked = character.starting_magic_items.to_h %>
  <% missing = character.errors[:starting_magic_items].any? %>
  <section class="mx-auto mt-8 w-full max-w-5xl min-w-0" aria-labelledby="starting-magic-items-title" aria-describedby="starting-magic-items-hint">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="starting-magic-items-title" class="text-xs font-bold tracking-widest text-muted uppercase"><%= t("#{CharacterSheets::MagicItemChoicesHelper::SCOPE}.title") %></h2>
      <% if (gold_text = higher_level_gold_text(tier)) %>
        <p class="text-[13px] font-semibold text-brass"><%= gold_text %></p>
      <% end %>
    </div>
    <p id="starting-magic-items-hint" class="mt-1 text-xs text-muted"><%= t("#{CharacterSheets::MagicItemChoicesHelper::SCOPE}.hint", level: character.current_level) %></p>
    <% if missing %>
      <p class="<%= SimpleFormFieldClasses::ERROR %>" role="alert"><%= t("#{CharacterSheets::MagicItemChoicesHelper::SCOPE}.missing") %></p>
    <% end %>
    <% if places.any? %>
      <ul class="mt-3 grid gap-x-10 lg:grid-cols-2">
        <% places.each do |place| %>
          <% select_id = "starting-magic-item-#{place.key}" %>
          <% empty = missing && picked[place.key].blank? %>
          <li class="<%= CharacterSheets::EquipmentChoicesHelper::CHOOSE_LINE_CLASSES %> lg:[&:nth-last-child(2):nth-child(odd)]:border-b-0">
            <span class="<%= CharacterSheets::EquipmentChoicesHelper::ITEM_MARKER_CLASSES %>" aria-hidden="true"></span>
            <%= label_tag select_id, magic_item_place_label(character, place, places), class: "truncate #{empty ? 'text-error-ink' : 'text-muted'}" %>
            <div class="relative flex min-w-0 items-center justify-end">
              <%= select_tag "character[starting_magic_items][#{place.key}]", magic_item_options(character, place),
                             include_blank: t("#{CharacterSheets::EquipmentChoicesHelper::SCOPE}.choose_prompt"), id: select_id,
                             class: CharacterSheets::MagicItemChoicesHelper::PICK_CLASSES, aria: { invalid: (true if empty) } %>
              <%= render "shared/icons/chevron_down", css_class: "pointer-events-none absolute right-0 size-3.5 text-brass" %>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="mt-3 text-xs text-muted"><%= t("#{CharacterSheets::MagicItemChoicesHelper::SCOPE}.enchantment_hint") %></p>
    <% end %>
  </section>
<% end %>
