<%# The third step of a table: the spells and items it customizes, one tab each (decision of 24 November: every entry
    of the template is offered at first; listing them all made the step too heavy). Only what the game master changed,
    added or turned off is listed (Catalogs::TableCustomizations). "Customize a spell" opens the whole catalog in a
    window (picked: listed, copied for the table); "Create a spell" an empty window. Each line saves as it changes:
    its switch (offered or turned off), its window (its values). Characters already made keep their copy of what they
    chose, said under the tabs, until the game master applies the changes to them (the button shows only when one is
    outdated). Saved in a window or by a switch, the page is refreshed by morphing, keeping its scroll %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= creation_page(current_step: "catalog", game_table: @game_table) do %>
  <%= page_header(title: t(".title"), subtitle: subtitle_lines(t(".intro"), t(".purpose"))) %>
  <nav class="inline-flex gap-1 self-start rounded-lg bg-field p-1" aria-label="<%= t(".tabs") %>">
    <% GameTables::CatalogsController::KINDS.each do |kind| %>
      <%= link_to t(".tab.#{kind}"), edit_game_table_catalog_path(@game_table, kind: kind),
                  aria: { current: ("page" if kind == @catalog_kind) },
                  class: "inline-flex h-8 items-center rounded-md px-3 text-sm text-ink transition-colors hover:bg-surface/60 aria-[current=page]:bg-surface aria-[current=page]:font-semibold aria-[current=page]:shadow-sm" %>
    <% end %>
  </nav>
  <p class="mt-5 max-w-2xl text-sm text-ink"><%= t(".all_offered.#{@catalog_kind}", count: @offered_count) %></p>
  <p class="mt-1 max-w-2xl text-sm text-muted"><%= t(".characters_keep_their_copy") %></p>
  <% if @characters_to_update_count.positive? %>
    <div class="mt-4 flex max-w-2xl flex-wrap items-center gap-x-4 gap-y-3">
      <p class="text-sm text-ink"><%= t(".apply_to_characters.outdated", count: @characters_to_update_count) %></p>
      <%= button_to t(".apply_to_characters.button"), game_table_catalog_application_path(@game_table, kind: @catalog_kind),
                    class: button_classes(:secondary),
                    form: { data: { turbo_confirm: t(".apply_to_characters.confirm", count: @characters_to_update_count),
                                    confirm_button: t(".apply_to_characters.confirm_button") } } %>
    </div>
  <% end %>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to game_table_catalog_picker_path(@game_table, kind: @catalog_kind),
                class: "#{button_classes(:primary)} gap-2", data: catalog_picker_link_data do %>
      <%= render "shared/icons/pencil" %>
      <%= t(".customize.#{@catalog_kind}") %>
    <% end %>
    <%= link_to new_game_table_catalog_entry_path(@game_table, kind: @catalog_kind),
                class: "#{button_classes(:secondary)} gap-2", data: catalog_entry_dialog_link_data do %>
      <%= render "shared/icons/plus" %>
      <%= t(".add.#{@catalog_kind}") %>
    <% end %>
  </div>

  <%= render "game_tables/catalogs/customizations", customizations: @customizations %>

  <%= form_with url: game_table_catalog_path(@game_table), method: :patch, class: "mt-auto flex flex-wrap justify-end gap-3 pt-10" do %>
    <%= link_to t(".back"), edit_game_table_settings_path(@game_table), class: button_classes(:secondary) %>
    <%= button_tag t("game_tables.creation_actions.continue"), type: "submit", class: button_classes(:primary) %>
  <% end %>
  <%# Outside the list: each window holds forms of its own %>
  <%= render "game_tables/catalogs/dialog" %>
  <%= render "game_tables/catalog_pickers/dialog" %>
<% end %>
