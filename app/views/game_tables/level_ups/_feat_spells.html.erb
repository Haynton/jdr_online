<%# The spells a feat gives at a level gained (Magic Initiate): its list to pick, then the spells of that list,
    prepared for each list and shown as soon as it is picked (a nested choice_blocks_controller.js); sent as
    level_up[feat_spells][spell_list] and level_up[feat_spells][by_list][<list>] (LevelUpFeat keeps the list picked) %>
<% settings = level_up.spell_settings(feat) %>
<% picks = level_up.feat_key == feat.key ? level_up.feat_spell_picks.to_h : {} %>
<div class="flex flex-col gap-6" data-controller="choice-blocks">
  <div>
    <%= render "game_tables/character_steps/feat_spell_list_choice", settings: settings, all_lists: feat.effects.dig("spell_picks", "lists"),
                                                                     field_name: "level_up[feat_spells][spell_list]",
                                                                     picked: picks["spell_list"], error_id: "level_up_feat_spells_error" %>
    <%= render "game_tables/level_ups/error", level_up: level_up, attribute: :feat_spells %>
  </div>
  <% Array(settings["lists"]).each do |list| %>
    <%= tag.div hidden: picks["spell_list"] != list, data: { choice_blocks_target: "block", choice_value: list } do %>
      <%= render "game_tables/character_steps/feat_spell_picks", character: level_up.character, list: list, settings: settings,
                                                                 field_name: "level_up[feat_spells][by_list][#{list}]",
                                                                 picks: picks["spell_list"] == list ? picks : {},
                                                                 known: level_up.known_spells %>
    <% end %>
  <% end %>
</div>
