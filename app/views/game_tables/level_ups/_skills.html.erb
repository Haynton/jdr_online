<%# The skills a subclass offers (the College of Lore: 3), among those not proficient yet: for_subclass, the one of
    its block (game_tables/level_ups/new) %>
<% for_subclass = local_assigns[:for_subclass] %>
<fieldset aria-describedby="level_up_skill_keys_error">
  <legend class="<%= LevelUpsHelper::SECTION_TITLE_CLASSES %>"><%= t("game_tables.level_ups.skills.title") %></legend>
  <p class="mt-2 text-sm text-muted"><%= t("game_tables.level_ups.skills.rule", count: level_up.skill_count(for_subclass)) %></p>
  <%= hidden_field_tag "level_up[skill_keys][]", "", id: nil %>
  <ul class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2">
    <% level_up.skill_candidates(for_subclass).each do |field| %>
      <li>
        <label class="flex items-center gap-2 text-sm text-ink">
          <%= check_box_tag "level_up[skill_keys][]", field["key"], level_up.skill_keys.include?(field["key"]),
                            id: "level_up_skill_#{field["key"]}", class: SimpleFormFieldClasses::CHECKBOX %>
          <%= field["label"] %>
        </label>
      </li>
    <% end %>
  </ul>
  <%= render "game_tables/level_ups/error", level_up: level_up, attribute: :skill_keys %>
</fieldset>
