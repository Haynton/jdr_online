<%# The points a feat lets share on the abilities (its ability_increase: the improvement +2 or +1 and +1, the grappler,
    an epic boon +1, up to its maximum), each line an ability it may raise, its score now (the bonus of the background
    and the feats taken in it) and +0 | +1 | +2 on real radio buttons %>
<% settings = level_up.increase_settings(feat) %>
<fieldset aria-describedby="level_up_ability_increases_error">
  <legend class="<%= LevelUpsHelper::SECTION_TITLE_CLASSES %>"><%= t("game_tables.level_ups.improvement.title") %></legend>
  <p class="mt-2 text-sm text-muted"><%= t("game_tables.level_ups.improvement.rule", points: settings["points"], maximum: settings["maximum"]) %></p>
  <ul class="mt-3 flex flex-col gap-2">
    <% level_up.increase_fields(feat).each do |field| %>
      <% placed = level_up.feat_key == feat.key ? level_up.ability_increases[field["key"]].to_i : 0 %>
      <% label_id = "level_up_#{feat.key}_#{field["key"]}_label" %>
      <li class="grid grid-cols-[minmax(0,1fr)_auto_3rem] items-center gap-3">
        <span id="<%= label_id %>" class="truncate text-sm text-ink"><%= field["label"] %></span>
        <div class="inline-flex gap-1 rounded-lg bg-field p-1" role="radiogroup" aria-labelledby="<%= label_id %>">
          <% (0..settings["max_per_ability"]).each do |points| %>
            <label class="<%= LevelUpsHelper::CHOICE_CLASSES %>">
              <%= radio_button_tag "level_up[ability_increases][#{field["key"]}]", points, placed == points, id: nil, class: "sr-only" %>
              +<%= points %>
            </label>
          <% end %>
        </div>
        <span class="text-right text-sm text-muted tabular-nums"><%= level_up.score_of(field) || "—" %></span>
      </li>
    <% end %>
  </ul>
  <%= render "game_tables/level_ups/error", level_up: level_up, attribute: :ability_increases %>
</fieldset>
