<%# The skills a feat gives to pick (Skilled: 3), among those the character is not proficient in yet, as chips with
    their count, the look of the skills of the species feat (decision of 28 November: the old boxes in two columns
    jarred on the step of the level feats); the others faded once enough are ticked (pick_limit_controller.js). Also in
    the window of a level gained %>
<% count = level_up.feat_skill_count(feat) %>
<%= tag.fieldset class: "min-w-0", aria: { describedby: "#{level_up.dom_prefix}_feat_skill_keys_error" },
                 data: { controller: "pick-limit", action: "change->pick-limit#count", pick_limit_allowed_value: count,
                         pick_limit_template_value: t("game_tables.character_steps.feat_spells.chosen", count: count, chosen: "__CHOSEN__") } do %>
  <legend class="<%= CharacterSheets::WeaponMasteryChoicesHelper::TITLE_CLASSES %>"><%= t("game_tables.level_ups.skills.title") %></legend>
  <p class="clear-left pt-2 text-sm text-ink"><%= t("game_tables.level_ups.feat.skills", count: count) %></p>
  <p class="pt-1 text-sm font-semibold text-brass data-invalid:text-error-ink" role="status" data-pick-limit-target="count">
    <%= t("game_tables.character_steps.feat_spells.chosen", count: count, chosen: level_up.feat_skill_keys.size) %>
  </p>
  <%= hidden_field_tag "#{level_up.form_name}[feat_skill_keys][]", "", id: nil %>
  <div class="flex flex-wrap gap-1.5 pt-3">
    <% level_up.feat_skill_candidates.each do |field| %>
      <label class="<%= CharacterSheets::WeaponMasteryChoicesHelper::CHIP_CLASSES %>">
        <%= check_box_tag "#{level_up.form_name}[feat_skill_keys][]", field["key"], level_up.feat_skill_keys.include?(field["key"]),
                          id: "#{level_up.dom_prefix}_feat_skill_#{field["key"]}", class: "peer sr-only",
                          data: { pick_limit_target: "box" } %>
        <span class="size-2.5 shrink-0 rotate-45 rounded-[2px] border border-brass group-has-checked/pick:bg-brass" aria-hidden="true"></span>
        <%= field["label"] %>
      </label>
    <% end %>
  </div>
  <%= render "game_tables/level_ups/error", level_up: level_up, attribute: :feat_skill_keys %>
<% end %>
