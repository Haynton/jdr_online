<%# The skills a feat gives to pick (Skilled: 3), among those the character is not proficient in yet %>
<fieldset aria-describedby="<%= level_up.dom_prefix %>_feat_skill_keys_error">
  <legend class="<%= LevelUpsHelper::SECTION_TITLE_CLASSES %>"><%= t("game_tables.level_ups.skills.title") %></legend>
  <p class="mt-2 text-sm text-muted"><%= t("game_tables.level_ups.feat.skills", count: level_up.feat_skill_count(feat)) %></p>
  <%= hidden_field_tag "#{level_up.form_name}[feat_skill_keys][]", "", id: nil %>
  <ul class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2">
    <% level_up.feat_skill_candidates.each do |field| %>
      <li>
        <label class="flex items-center gap-2 text-sm text-ink">
          <%= check_box_tag "#{level_up.form_name}[feat_skill_keys][]", field["key"], level_up.feat_skill_keys.include?(field["key"]),
                            id: "#{level_up.dom_prefix}_feat_skill_#{field["key"]}", class: SimpleFormFieldClasses::CHECKBOX %>
          <%= field["label"] %>
        </label>
      </li>
    <% end %>
  </ul>
  <%= render "game_tables/level_ups/error", level_up: level_up, attribute: :feat_skill_keys %>
</fieldset>
