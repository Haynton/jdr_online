<%# The game room of a table (layouts/game_room): the board fills the screen, its place kept while it comes (Julien's
    branch). The name of the table is the title of the page, in the island at the top left; the islands come from the
    layout %>
<% content_for :title, @game_table.name %>
<div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center">
  <span class="flex size-14 items-center justify-center rounded-2xl bg-primary-soft text-primary-soft-ink" aria-hidden="true">
    <%= render "shared/icons/map", css_class: "size-7" %>
  </span>
  <p class="max-w-md text-sm text-muted"><%= t(".board_coming_soon") %></p>
</div>
