<%# The game room of a table (layouts/game_room): the board fills the screen. Its first version (room_board_controller.js,
    nothing saved yet: the real board comes with its own branch): for the game master, the drawn maps of the table,
    each drawn like its preview and hidden until « Placer » in the panel « Cartes » shows it on the whole screen, under
    the islands, as large as it fits without being cut (decision), until « Retirer »;
    a creature taken by « Placer » in the panel « PNJ et ennemis » is put on it by a click, its name in the hint at the
    top, above the panel still open (z-40). In development and in the tests only (GameRoom.preview_features?) Until a map is on the board, its place is kept. The name of the table is the title of the page, in the island
    at the top left %>
<% content_for :title, @game_table.name %>
<div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center" data-room-board-target="placeholder">
  <span class="flex size-14 items-center justify-center rounded-2xl bg-primary-soft text-primary-soft-ink" aria-hidden="true">
    <%= render "shared/icons/map", css_class: "size-7" %>
  </span>
  <p class="max-w-md text-sm text-muted"><%= t(".board_coming_soon") %></p>
</div>
<% if @game_room.game_master? && GameRoom.preview_features? %>
  <% @game_room.game_maps.select(&:drawn?).each do |game_map| %>
    <svg hidden viewBox="<%= game_map_view_box(game_map) %>" role="img" aria-label="<%= game_map.name %>"
         class="absolute inset-0 size-full in-data-placing:cursor-crosshair"
         data-room-board-target="map" data-map-id="<%= game_map.id %>"
         data-action="click->room-board#placeAtPointer contextmenu->room-board#dropCreatureWithRightClick"
         <%= tag.attributes(data: game_map_preview_data(game_map)) %>></svg>
  <% end %>
  <p hidden class="<%= GameRoomHelper::ISLAND_CLASSES %> absolute top-22 left-1/2 z-40 -translate-x-1/2 px-4 py-2 text-sm text-ink"
     role="status" data-room-board-target="hint">
    <span data-room-board-target="hintName"></span>
  </p>
<% end %>
