<%# One table of the user. Choosing it shows it large at the top of the page (table_card_data) %>
<% game_table = participation.game_table %>
<%= render layout: "game_tables/ogive_card",
           locals: { path: game_tables_path(table: game_table.id), cover_image_path: game_table.cover_image_path,
                     aria: table_card_aria(participation, chosen_participation), data: table_card_data } do %>
  <%# ink at 75 % rather than muted: muted falls under 4.5 on the card veil of the light theme %>
  <span class="text-[11px] font-semibold tracking-widest uppercase">
    <span class="text-brass"><%= table_role_label(participation) %></span>
    <span class="text-ink/75">· <%= table_detail_label(participation) %></span>
  </span>
  <span class="text-lg leading-tight font-semibold text-balance"><%= game_table.name %></span>
  <span class="text-[13px] text-ink/75"><%= table_players_label(game_table) %></span>
<% end %>
