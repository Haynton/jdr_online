<%# The cover of the chosen table takes the whole width, so this page fills the layout itself %>
<% content_for :full_width_page do %>
  <main class="min-w-0">
    <div class="mx-4"><%= render "shared/flashes" %></div>
    <% if @chosen_participation %>
      <%= render "game_tables/stage", participation: @chosen_participation %>
    <% else %>
      <%= render "game_tables/empty_stage" %>
    <% end %>
    <%= render "game_tables/shelf", participations: @participations, chosen_participation: @chosen_participation %>
  </main>
<% end %>
