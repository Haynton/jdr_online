<%# A dashboard as tall as the screen, like an app: the cover takes the room the row of cards leaves.
    On a phone, exactly the screen height less the 80 px kept under the floating bar (a minimum height let the page
    grow past the screen); below 544 px it scrolls rather than cut anything. From 768 px, at least the screen height.
    The chosen table sits in a Turbo Frame: choosing a card only replaces it (and the ?table= of the address).
    Reloading the whole page made the row of cards jump back into place, gold outline included.
    target="_top": the links inside (join, settings, create) still open a whole page %>
<% use_deep_page_background %>
<% content_for :full_width_page do %>
  <main class="flex h-[calc(100dvh-5rem)] min-h-[34rem] min-w-0 flex-col md:h-auto md:min-h-dvh">
    <div class="mx-4"><%= render "shared/flashes" %></div>
    <%= turbo_frame_tag "chosen_table", target: "_top", class: "flex min-h-0 flex-1 flex-col" do %>
      <% if @chosen_participation %>
        <%= render "game_tables/stage", participation: @chosen_participation %>
      <% else %>
        <%= render "game_tables/empty_stage" %>
      <% end %>
    <% end %>
    <%= render "game_tables/shelf", participations: @participations, chosen_participation: @chosen_participation %>
  </main>
<% end %>
