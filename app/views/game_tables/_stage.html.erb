<%# The chosen table, large, over its cover: what it is, the way in, and who plays there %>
<% game_table = participation.game_table %>
<%= render layout: "game_tables/cover", locals: { cover_image_path: game_table.cover_image_path, title_id: "chosen-table-title" } do %>
  <p class="text-xs font-semibold tracking-widest uppercase">
    <span class="text-brass"><%= table_role_label(participation) %></span>
    <span class="text-muted">· <%= table_detail_label(participation) %></span>
  </p>
  <h1 id="chosen-table-title" class="text-3xl leading-tight font-bold tracking-tight text-balance text-ink md:text-[40px]">
    <%= game_table.name %>
  </h1>
  <% if game_table.description.present? %>
    <%# Three lines at most, two on a phone, none on a short phone screen: the page has to fit in the screen height %>
    <p class="line-clamp-2 max-w-md text-[15px] text-ink md:line-clamp-3 max-md:[@media(max-height:700px)]:hidden"><%= game_table.description %></p>
  <% end %>
  <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-3">
    <%# An invitation not answered yet: accept or decline it, instead of joining the game %>
    <% if participation.pending? %>
      <%= render "game_tables/invitation_answers", participation: participation %>
    <% else %>
      <%= render "game_tables/table_actions", participation: participation %>
    <% end %>
    <%= render "game_tables/players", game_table: game_table %>
  </div>
<% end %>
