<%# Last step of the creation, named "Invitation" in the band: the table large over its cover, as "My tables" will
    show it, then two columns: the invitation (link and username) and the participants. Its two buttons finish the
    creation: back to "My tables", or into the game.
    No page title above the cover (decision: it kept the picture away from the band of the steps): the name of the
    table is the title of the page. NPCs and maps, coming soon, show only in the band of the steps (decision) %>
<%= creation_page(current_step: "summary", game_table: @game_table, flush_top: true) do %>
  <%# From edge to edge of the content, right under the band of the steps, like the cover of "My tables" %>
  <section class="relative isolate -mx-4 flex min-h-64 flex-col justify-end overflow-hidden px-4 pt-12 pb-8 sm:-mx-8 sm:px-8"
           aria-labelledby="summary-table-title">
    <%= image_tag @game_table.cover_image_path, alt: "", class: "absolute inset-0 -z-20 size-full object-cover cover-fade" %>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-page via-page/80 to-transparent md:bg-linear-to-r md:via-page/70"></div>

    <div class="flex max-w-xl flex-col items-start gap-2">
      <p class="text-xs font-semibold tracking-widest uppercase">
        <span class="text-brass"><%= t("game_tables.roles.game_master") %></span>
        <span class="text-muted">· <%= t("game_tables.statuses.draft") %></span>
      </p>
      <h1 id="summary-table-title" class="text-3xl leading-tight font-bold tracking-tight text-balance text-ink md:text-[40px]">
        <%= @game_table.name %>
      </h1>
      <%# A long description is cut after 3 lines, "See more" shows it all (read_more_controller.js) %>
      <div class="flex flex-col items-start gap-1" data-controller="read-more"
           data-read-more-more-label-value="<%= t(".see_more") %>" data-read-more-less-label-value="<%= t(".see_less") %>">
        <p id="summary-description" class="text-[15px] text-ink data-clamped:line-clamp-3" data-read-more-target="text">
          <%= summary_description(@game_table) %>
        </p>
        <button type="button" hidden class="text-sm font-medium text-link hover:underline" aria-expanded="false"
                aria-controls="summary-description" data-read-more-target="button" data-action="read-more#toggle">
          <%= t(".see_more") %>
        </button>
      </div>
      <p class="text-sm text-ink">
        <%= t(".sheet_template") %> <span class="font-semibold"><%= summary_sheet_template_name(@game_table) %></span>
      </p>
      <%= link_to t(".change"), edit_game_table_details_path(@game_table), class: "#{button_classes(:secondary, size: :compact)} mt-2" %>
    </div>
  </section>

  <%# Two columns without cards (decision): each one under a fine line. No "Your table is ready" above them any more
      (decision): the band of the steps and the buttons already say where the game master stands %>
  <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
    <%= render "game_tables/summaries/invitation", game_table: @game_table, player_invitation: @player_invitation %>
    <%= render "game_tables/summaries/participants", game_table: @game_table %>
  </div>

  <%# Finishing does not force the game master into the game: the main button leads back to "My tables". At the bottom
      of the screen on a short page (mt-auto), with at least 40 px above, as on the steps of a character %>
  <%= form_with url: game_table_summary_path(@game_table), method: :patch, class: "mt-auto pt-10" do |form| %>
    <div class="flex flex-wrap justify-end gap-3">
      <%= link_to t(".back"), edit_game_table_cast_path(@game_table), class: button_classes(:secondary) %>
      <%# On a table ready (its "Game settings"): each step saved its own changes, this one leads back to "My tables" %>
      <% if @game_table.draft? %>
        <%= form.button t(".finish_and_join"), name: "join_game", value: "1", class: button_classes(:secondary) %>
        <%= form.button t(".finish"), class: button_classes(:primary) %>
      <% else %>
        <%= form.button t(".confirm_changes"), class: button_classes(:primary) %>
      <% end %>
    </div>
  <% end %>
<% end %>
