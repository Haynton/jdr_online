<%# The window of a map, over the list of the step Maps, like the window of an NPC (game_tables/npcs/_dialog): empty
    until a card or "Add a map" is clicked; its form loads into the frame and frame_dialog_controller.js opens it.
    Saved, the server refreshes the list behind and the window closes %>
<dialog id="map-dialog" aria-labelledby="map-dialog-title" tabindex="-1" data-turbo-prefetch="false" data-turbo-permanent
        class="m-auto max-h-[min(760px,calc(100dvh-2rem))] w-[min(720px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl outline-none backdrop:bg-black/50 open:flex"
        data-controller="frame-dialog"
        data-action="turbo:frame-load->frame-dialog#open click->frame-dialog#closeOnBackdrop close->frame-dialog#empty turbo:submit-end->frame-dialog#closeOnSuccess turbo:before-cache@document->frame-dialog#close">
  <%= turbo_frame_tag GameTables::MapDialogHelper::MAP_FRAME, class: "flex min-h-0 flex-1 flex-col",
                                                             data: { frame_dialog_target: "frame" } %>
</dialog>
