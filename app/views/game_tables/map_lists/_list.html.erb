<%# The maps of the table, in the order they were added, in a row of cards that scrolls sideways like everywhere on
    the site for cards of this kind (Anthony's request; game_tables/_choice_row, a section named by its heading: the
    cards are links, not choices); a dashed box while there is none %>
<div id="map-list" class="mt-8">
  <% if game_maps.empty? %>
    <p class="max-w-xl rounded-xl border border-dashed border-line px-6 py-8 text-sm text-muted"><%= t("game_tables.map_lists.edit.empty") %></p>
  <% else %>
    <%= render layout: "game_tables/choice_row",
               locals: { legend: t("game_tables.map_lists.edit.count", count: game_maps.size), heading_id: "map-list-title" } do %>
      <% game_maps.each do |game_map| %>
        <%= render "game_tables/map_lists/game_map", game_map: game_map %>
      <% end %>
    <% end %>
  <% end %>
</div>
