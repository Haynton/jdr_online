<%# Where the game master stands in the creation of a table: the four steps (shared/_steps_band). NPCs and maps
    arrive with their milestone: marked as coming soon %>
<% steps = creation_steps(current_step, game_table).map { |step| step.merge(label: t(".steps.#{step[:key]}")) } %>
<%= render "shared/steps_band", steps: steps, label: t(".label") %>
