<%# First step of the creation of a table: name, description, cover and sheet template.
    Shared by a new table (game_tables/new) and a draft taken up again (game_tables/details/edit).
    The covers and the templates are rows of cards that scroll sideways (game_tables/_choice_row), like the row
    of "My tables". Each card hides a real radio button (sr-only, the peer of the card), still moved with the arrow
    keys and read by screen readers (game_table_creation_helper.rb). On a phone, a card takes a share of the row
    (62 %), so that the next one shows cut off: the row says it scrolls. The texts of the cards use full keys:
    inside a render layout block, a short key would be looked up for the row partial %>
<%# The form fills the rest of the page (flex-1): its buttons go to the bottom of the screen on a short step, as on
    the steps of a character (decision) %>
<%= simple_form_for game_table, url: url, method: method, html: { id: creation_form_id, class: "flex flex-1 flex-col" },
                                defaults: { wrapper_html: { class: "max-w-xl" } } do |form| %>
  <%= form_error_notification(form) %>

  <%= form.input :name, required: true, autofocus: true, input_html: { maxlength: GameTable::NAME_MAX_LENGTH } %>
  <%= form.input :description, as: :text, required: false, hint: t(".description_hint") %>

  <%# The covers filtered by theme (fantasy, horror, science fiction), with the pills of "My tables" %>
  <%= render layout: "game_tables/choice_row", locals: { legend: t(".cover"), hint: t(".cover_hint"),
                                                         filters: cover_filters, no_match: t(".no_matching_cover") } do %>
    <% GameTable::COVER_IMAGES.each do |cover_image| %>
      <%= tag.li class: "relative w-[62%] shrink-0 sm:w-44", data: cover_card_filter_data(cover_image) do %>
        <%= form.radio_button :cover_image, cover_image, class: "peer sr-only" %>
        <%= form.label :cover_image, value: cover_image, class: choice_tile_classes do %>
          <%= image_tag GameTable.cover_image_path(cover_image), alt: "", loading: "lazy", class: "aspect-video w-full object-cover" %>
          <span class="block px-3 py-2 text-sm text-ink"><%= cover_choice_label(cover_image) %></span>
        <% end %>
        <span class="<%= choice_check_classes %>" aria-hidden="true"><%= render "shared/icons/check", css_class: "size-4" %></span>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "game_tables/choice_row",
             locals: { legend: safe_join([t(".sheet_template"), t("simple_form.required.html")], " "),
                       hint: t(".sheet_template_hint"),
                       error: form.error(:sheet_template, id: "sheet-template-error", class: choice_error_classes) } do %>
    <li class="w-[62%] shrink-0 sm:w-56">
      <%# To "My templates", where a template is made by duplicating another one (template editor) %>
      <%= link_to sheet_templates_path, class: create_template_card_classes do %>
        <span class="flex size-11 items-center justify-center rounded-full bg-brass text-page" aria-hidden="true">
          <%= render "shared/icons/plus", css_class: "size-5" %>
        </span>
        <span class="font-semibold"><%= t("game_tables.details_form.create_template") %></span>
      <% end %>
    </li>
    <% @available_sheet_templates.each do |sheet_template| %>
      <li class="relative w-[62%] shrink-0 sm:w-56">
        <%= form.radio_button :sheet_template_id, sheet_template.id, class: "peer sr-only", required: true,
                              aria: sheet_template_choice_aria(game_table) %>
        <%= form.label :sheet_template_id, value: sheet_template.id, class: choice_tile_classes do %>
          <%# Its icon and the color of its banner, chosen in the template editor (SheetTemplate::ICONS, BANNER_CLASSES) %>
          <span class="flex aspect-video w-full items-center justify-center <%= banner_classes(sheet_template.banner_color, :background) %> <%= banner_classes(sheet_template.banner_color, :accent) %>" aria-hidden="true">
            <%= sheet_template_icon(sheet_template.icon, css_class: "size-10") %>
          </span>
          <%# Its name on one line, its description on 2 lines, their room kept without one: every card the same
              height (decision, as in "My templates") %>
          <span class="block truncate px-4 pt-3 pr-10 font-semibold text-ink"><%= sheet_template.name %></span>
          <span class="line-clamp-2 min-h-[2lh] px-4 pb-3 text-sm break-words text-ink"><%= sheet_template.description %></span>
        <% end %>
        <span class="<%= choice_check_classes %>" aria-hidden="true"><%= render "shared/icons/check", css_class: "size-4" %></span>
      </li>
    <% end %>
  <% end %>

  <%# At the end of the form, on the right: where the eye ends up once everything is filled in. At the bottom of the
      screen when the step is short (mt-auto), with at least 40 px above them, as on the steps of a character %>
  <div class="mt-auto flex flex-wrap justify-end gap-3 pt-10">
    <%= creation_actions(cancel_path: cancel_path) %>
  </div>
<% end %>
