<%= auth_card(title: t(".title"), subtitle: t(".subtitle")) do %>
  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= form_error_notification(f) %>

    <%= f.input :email,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "email" } %>

    <%= f.button :submit, t(".send_me_reset_password_instructions"),
                 class: button_classes(:primary, full_width: true) %>
  <% end %>

  <%= render "shared/divider", text: t(".remember_it") %>
  <%= link_to t(".back_to_sign_in"), new_session_path(resource_name),
              class: button_classes(:secondary, full_width: true) %>
<% end %>
