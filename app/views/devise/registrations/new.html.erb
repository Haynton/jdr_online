<%= auth_card(title: t(".title"), subtitle: t(".subtitle")) do %>
  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |form| %>
    <%= form_error_notification(form) %>

    <%= form.input :username,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "nickname" } %>
    <%= form.input :email,
                required: true,
                input_html: { autocomplete: "email" } %>
    <%= form.input :password,
                required: true,
                hint: (t("devise.shared.minimum_password_length", count: @minimum_password_length) if @minimum_password_length),
                input_html: { autocomplete: "new-password" } %>
    <%= form.input :password_confirmation,
                required: true,
                input_html: { autocomplete: "new-password" } %>

    <%= form.button :submit, t(".submit"), class: button_classes(:primary, full_width: true) %>
  <% end %>

  <p class="mt-5 text-center text-sm text-muted">
    <%= t(".already_registered") %>
    <%= link_to t(".sign_in"), new_session_path(resource_name), class: "font-medium text-link hover:underline" %>
  </p>
<% end %>
