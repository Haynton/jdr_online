# Copy to .env and fill in. Never commit .env

# Production only: the address of the app, used by the links in the emails (fumble-quest.herokuapp.com)
APP_HOST=

# Production only: the SMTP relay of Brevo, which sends the emails (Brevo › SMTP & API › SMTP)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Production only: the account of Cloudinary, which stores the images of the maps (Cloudinary › Settings › API Keys:
# cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
